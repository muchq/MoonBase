{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "schedule": [
    "* 1 2 */2 *"
  ],
  "packageRules": [
    {
      "description": "java_base tracks Java LTS majors only (every fourth release from 21).",
      "matchPackageNames": [
        "docker.io/azul/zulu-openjdk",
        "azul/zulu-openjdk"
      ],
      "allowedVersions": "/^(25|29|33|37)$/"
    }
  ]
}
