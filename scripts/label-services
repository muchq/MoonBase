#!/bin/bash
# Bring a PR's service:* labels in line with the services a change reaches.
#
# Usage: label-services PR_NUMBER SERVICES_FILE
#
# SERVICES_FILE is one service name per line, as scripts/impacted-services
# writes it. Labels for services not in the file are removed, so a PR that
# stops touching a service loses the label on its next run; labels outside
# the service: prefix are never touched. Each wanted label is created or
# refreshed before it is applied, so a new service needs nothing by hand and
# two PRs introducing the same label at once cannot race each other.
#
# A missing SERVICES_FILE is an unknown answer: the PR gets service:unknown
# beside whatever service labels it has, and loses none. A first run can then
# be told apart from "no image changed", and a later run that does know the
# answer retires the marker like any other stale label.
#
# Runs through gh, which reads GH_TOKEN and GH_REPO from the environment.
# Any gh failure fails the script: a token that cannot write is a
# misconfiguration to see, not to shrug past.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=diff-build-lib.sh
source "$SCRIPT_DIR/diff-build-lib.sh"

PR=${1:?usage: label-services PR_NUMBER SERVICES_FILE}
SERVICES=${2:?usage: label-services PR_NUMBER SERVICES_FILE}

HAVE=$(mktemp)
trap 'rm -f "$HAVE"' EXIT
gh api "repos/{owner}/{repo}/issues/$PR/labels" --paginate --jq '.[].name' > "$HAVE"

ensure_label() { # ensure_label <label>
  local description="Changes the ${1#"$SERVICE_LABEL_PREFIX"} image"
  [ "$1" != "$UNKNOWN_LABEL" ] || description="Impacted services could not be computed"
  gh label create "$1" --force --color 0e8a16 --description "$description"
}

if [ ! -f "$SERVICES" ]; then
  if grep -qx "$UNKNOWN_LABEL" "$HAVE"; then
    echo "impacted services unknown; $UNKNOWN_LABEL already applied"
  else
    ensure_label "$UNKNOWN_LABEL"
    gh pr edit "$PR" --add-label "$UNKNOWN_LABEL"
    echo "impacted services unknown; $UNKNOWN_LABEL applied, other labels kept"
  fi
  exit 0
fi

# Planned into a file first: a plan that failed to compute must stop here,
# and a process substitution's failure would not.
PLAN=$(mktemp)
trap 'rm -f "$HAVE" "$PLAN"' EXIT
service_label_plan "$SERVICES" "$HAVE" > "$PLAN"

ADD=""
REMOVE=""
while read -r verb label; do
  case "$verb" in
    add)
      ensure_label "$label"
      ADD="$ADD,$label"
      ;;
    remove) REMOVE="$REMOVE,$label" ;;
  esac
done < "$PLAN"

EDIT=()
[ -z "$ADD" ] || EDIT+=(--add-label "${ADD#,}")
[ -z "$REMOVE" ] || EDIT+=(--remove-label "${REMOVE#,}")
if [ "${#EDIT[@]}" -gt 0 ]; then
  gh pr edit "$PR" "${EDIT[@]}"
fi
echo "labels in sync: $(tr '\n' ' ' < "$SERVICES")"
