#!/bin/bash
# Exercises deploy.sh end to end without a host, a docker daemon, or a network.
#
# The remote half of a deploy is just a string handed to ssh, so a stub `ssh`
# that *executes* what it receives — against a throwaway HOME and a stub
# `docker` — runs the real code path, including the heredoc. That's the half
# local testing otherwise can't reach, and where the bugs have been.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

STUBS=$WORK/bin
TESTROOT=$WORK/repo
ORIGIN=$WORK/origin.git
HOSTDIR=$WORK/host
DOCKER_LOG=$WORK/docker.log
IMAGES=$WORK/images
REGISTRY_LOG=$WORK/registry.log

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() { # check <description> <condition-as-args>
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}
host_env_has() { grep -qx "$1" "$HOSTDIR/.env"; }
host_env_lacks() { ! grep -q "^$1=" "$HOSTDIR/.env"; }

# ---------------------------------------------------------------- stubs

make_stubs() {
  mkdir -p "$STUBS"

  # Runs the received command (or heredoc on stdin) against the fake host.
  # `~` resolves through HOME, so the script's ~/.env manipulation lands there.
  cat > "$STUBS/ssh" <<'STUB'
#!/bin/bash
while [ $# -gt 0 ]; do
  case "$1" in
    -o) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
shift # host
export HOME="$FAKE_HOST"
cd "$FAKE_HOST" || exit 1
if [ $# -gt 0 ]; then bash -c "$*"; else bash -s; fi
STUB

  cat > "$STUBS/scp" <<'STUB'
#!/bin/bash
args=()
for a in "$@"; do [ "$a" = "-r" ] || args+=("$a"); done
last=$((${#args[@]} - 1))   # not ${args[-1]}; bash 3.2 has no negative indices
dest=${args[$last]}
unset "args[$last]"
path=${dest#*:}   # host:~/foo -> ~/foo
path=${path#\~/}
target="$FAKE_HOST/$path"
case "$dest" in
  */) mkdir -p "$target" ;;
  *) mkdir -p "$(dirname "$target")" ;;
esac
cp -r "${args[@]}" "$target" 2>/dev/null || true
STUB

  # The remote payload targets the Linux host, so it uses GNU `xargs -r`. The
  # stub ssh runs that payload locally, and BSD xargs rejects -r — drop the
  # flag rather than weaken the command that actually ships.
  cat > "$STUBS/xargs" <<'STUB'
#!/bin/bash
args=()
for a in "$@"; do [ "$a" = "-r" ] || args+=("$a"); done
exec /usr/bin/xargs "${args[@]}"
STUB

  # Only docker is really run; mkdir/cp/chown against absolute host paths
  # (/var/www, /etc/forgejo) are neutralised so a test can't touch this machine.
  cat > "$STUBS/sudo" <<'STUB'
#!/bin/bash
[ "$1" = "-E" ] && shift
case "$1" in
  docker) exec "$@" ;;
  *) exit 0 ;;
esac
STUB

  # Records what compose would have been invoked with, including the pin
  # variables visible in its environment — that's how a stale exported pin
  # beating the .env file becomes observable.
  cat > "$STUBS/docker" <<'STUB'
#!/bin/bash
case "$1" in
  manifest)
    for missing in $FAKE_MISSING_IMAGES; do
      case "$3" in "$missing":*) exit 1 ;; esac
    done
    exit 0
    ;;
  network)
    # Report the expected subnet so the script doesn't tear the network down.
    echo "172.28.0.0/16|172.28.1.0/24"
    exit 0
    ;;
  ps)
    # -aq is asked for ids; the rest of the stub uses service names as ids.
    case "$*" in
      *-aq*) printf '%s\n' "$FAKE_PS" | sed 's/|.*//' ;;
      *) printf '%s\n' "$FAKE_PS" | sed 's/^/S|/' ;;
    esac
    exit 0
    ;;
  inspect)
    shift 3 # past `inspect --format <template>`
    for svc in "$@"; do
      count=$(printf '%s\n' "$FAKE_RESTARTS" | sed -n "s/^$svc|//p")
      echo "R|$svc|${count:-0}"
    done
    exit 0
    ;;
esac
# Records what compose would have been invoked with, including the pin
# variables visible in its environment — that's how a stale exported pin
# beating the .env file becomes observable.
pins=$(env | grep -E '^([A-Z0-9_]+_SHA)=' | sort | tr '\n' ' ')
echo "docker $* || env: $pins" >> "$DOCKER_LOG"
exit 0
STUB

  # The registry, for --list --service. A token request answers with a token
  # unless FAKE_NO_REPO is set. A tag listing answers with the shas that have
  # a file in $FAKE_IMAGES for that service, two per page when
  # FAKE_TAG_PAGE is set. A manifest request answers from
  # $FAKE_IMAGES/<service>_<sha>, whose one line is the image's content, and
  # 404 without one; the first one is a 401 when FAKE_STALE_TOKEN is set, and
  # FAKE_REGISTRY_DOWN makes one a 503 once that many have been served.
  # Records each request in $REGISTRY_LOG.
  cat > "$STUBS/curl" <<'STUB'
#!/bin/bash
out=/dev/null hdr=/dev/null url= headers=
while [ $# -gt 0 ]; do
  case "$1" in
    -H) headers="$headers[$2]"; shift 2 ;;
    -o) out=$2; shift 2 ;;
    -D) hdr=$2; shift 2 ;;
    -w | --connect-timeout | --max-time | --retry) shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
case "$url" in
  */token?*)
    echo token >> "$REGISTRY_LOG"
    [ -n "${FAKE_NO_REPO:-}" ] || printf '{"token":"t"}'
    ;;
  */v2/muchq/*/tags/list*)
    rest=${url#*/v2/muchq/}
    service=${rest%%/*}
    echo "tags $service" >> "$REGISTRY_LOG"
    : > "$hdr"
    all=$(ls "$FAKE_IMAGES" 2>/dev/null | sed -n "s/^${service}_//p" | sort)
    if [ -n "${FAKE_TAG_PAGE:-}" ]; then
      case "$url" in
        *last=*) last=${url##*last=}; last=${last%%&*}; all=$(printf '%s\n' "$all" | sed "1,/^$last\$/d") ;;
      esac
      page=$(printf '%s\n' "$all" | head -n "$FAKE_TAG_PAGE")
      if [ "$(printf '%s\n' "$all" | grep -c .)" -gt "$FAKE_TAG_PAGE" ]; then
        printf 'Link: </v2/muchq/%s/tags/list?last=%s&n=%s>; rel="next"\r\n' \
          "$service" "$(printf '%s\n' "$page" | tail -1)" "$FAKE_TAG_PAGE" > "$hdr"
      fi
    else
      page=$all
    fi
    printf '{"name":"muchq/%s","tags":["latest"%s]}' "$service" \
      "$(printf '%s\n' "$page" | grep . | sed 's/.*/,"&"/' | tr -d '\n')" > "$out"
    echo 200
    ;;
  */v2/muchq/*/manifests/*)
    rest=${url#*/v2/muchq/}
    echo "manifest ${rest%%/*} ${rest##*/} $headers" >> "$REGISTRY_LOG"
    served=$(grep -c '^manifest' "$REGISTRY_LOG")
    if [ -n "${FAKE_STALE_TOKEN:-}" ] && [ "$served" -eq 1 ]; then
      echo 401
      exit 0
    fi
    if [ -n "${FAKE_REGISTRY_DOWN:-}" ] && [ "$served" -gt "$FAKE_REGISTRY_DOWN" ]; then
      echo 503
      exit 0
    fi
    key=$FAKE_IMAGES/${rest%%/*}_${rest##*/}
    if [ -f "$key" ]; then
      printf '{"config":{"digest":"sha256:%s"},"layers":[]}' "$(cat "$key")" > "$out"
      echo 200
    else
      echo 404
    fi
    ;;
esac
STUB

  chmod +x "$STUBS"/*
}

# ---------------------------------------------------------------- fixture

# A throwaway repo so deploy.sh's real git calls work offline: it self-locates
# to its ../.. and resolves targets against origin/main.
make_repo() {
  rm -rf "$TESTROOT" "$ORIGIN"
  mkdir -p "$TESTROOT/deploy/consolidated/o11y" \
    "$TESTROOT/deploy/consolidated/forgejo" \
    "$TESTROOT/fixture"
  mkdir -p "$TESTROOT/scripts"
  cp "$REPO/deploy/consolidated/deploy.sh" "$TESTROOT/deploy/consolidated/"
  cp "$REPO/scripts/image-lib.sh" "$TESTROOT/scripts/"
  cp "$REPO/deploy/consolidated/compose.yaml" "$TESTROOT/deploy/consolidated/"
  cp "$REPO/deploy/consolidated/docker-compose.observability.yml" "$TESTROOT/deploy/consolidated/"
  cp "$REPO/deploy/consolidated/o11y/"* "$TESTROOT/deploy/consolidated/o11y/"
  echo "# caddy" > "$TESTROOT/deploy/consolidated/Caddyfile"
  echo "[server]" > "$TESTROOT/deploy/consolidated/forgejo/app.ini"
  echo "<html></html>" > "$TESTROOT/fixture/index.html"

  git -C "$TESTROOT" init -q -b main
  local g="git -C $TESTROOT -c user.email=t@example.com -c user.name=test"
  $g add -A
  $g commit -qm "oldest change (#1000)"
  echo "w" > "$TESTROOT/fixture/v1.txt"
  $g add -A
  $g commit -qm "older change (#1001)"
  echo "x" > "$TESTROOT/fixture/v2.txt"
  $g add -A
  $g commit -qm "middle change (#1002)"
  echo "y" >> "$TESTROOT/fixture/v2.txt"
  $g add -A
  $g commit -qm "newest change (#1003)"

  git init -q --bare "$ORIGIN"
  git -C "$TESTROOT" remote add origin "$ORIGIN"
  git -C "$TESTROOT" push -q origin main
  git -C "$TESTROOT" fetch -q origin main

  # Untracked, like the real one (.gitignore'd) and holding secrets only. Its
  # presence matters: deploy.sh copies it over the host's ~/.env, which is
  # what made a targeted deploy drop the pins the host was relying on.
  {
    echo "ONE_D4_DB_PASSWORD=supersecret"
    echo "ONE_D4_SENTRY_DSN=https://sentry.example"
  } > "$TESTROOT/.env"
}

# Fake host carrying secrets plus whatever pins a scenario starts from.
reset_host() {
  rm -rf "$HOSTDIR"
  mkdir -p "$HOSTDIR"
  : > "$DOCKER_LOG"
  {
    echo "ONE_D4_DB_PASSWORD=supersecret"
    echo "ONE_D4_SENTRY_DSN=https://sentry.example"
    for line in "$@"; do echo "$line"; done
  } > "$HOSTDIR/.env"
  chmod 600 "$HOSTDIR/.env"
}

deploy() { # deploy <args...> -> exit code, output in $WORK/out.txt
  # Run from the fixture so the script under test can't reach the real repo,
  # whether or not it self-locates.
  : > "$REGISTRY_LOG"
  (
    cd "$TESTROOT" || exit 1
    PATH="$STUBS:$PATH" FAKE_HOST="$HOSTDIR" DOCKER_LOG="$DOCKER_LOG" \
      FAKE_MISSING_IMAGES="${FAKE_MISSING_IMAGES:-}" FAKE_PS="${FAKE_PS:-}" \
      FAKE_RESTARTS="${FAKE_RESTARTS:-}" FAKE_IMAGES="$IMAGES" \
      FAKE_REGISTRY_DOWN="${FAKE_REGISTRY_DOWN:-}" FAKE_NO_REPO="${FAKE_NO_REPO:-}" \
      FAKE_STALE_TOKEN="${FAKE_STALE_TOKEN:-}" FAKE_TAG_PAGE="${FAKE_TAG_PAGE:-}" \
      REGISTRY_LOG="$REGISTRY_LOG" \
      bash deploy/consolidated/deploy.sh "$@"
  ) > "$WORK/out.txt" 2>&1
}

# ---------------------------------------------------------------- cases

make_stubs
make_repo
SHA=$(git -C "$TESTROOT" rev-parse origin/main)
OLD_SHA=$(git -C "$TESTROOT" rev-parse "origin/main~2")
OLDEST_SHA=$(git -C "$TESTROOT" rev-parse "origin/main~3")

echo "full deploy"
reset_host "DEPLOY_SHA=previoussha"
deploy -y
rc=$?
check "exits 0" test $rc -eq 0
check "pins DEPLOY_SHA to the target commit" host_env_has "DEPLOY_SHA=$SHA"
check "keeps secrets" host_env_has "ONE_D4_DB_PASSWORD=supersecret"
check "pulls and ups every service" \
  grep -q -- "up -d --remove-orphans" "$DOCKER_LOG"
check "keeps .env at mode 600" \
  test "$(stat -c '%a' "$HOSTDIR/.env" 2>/dev/null || stat -f '%Lp' "$HOSTDIR/.env")" = 600

echo "targeted deploy"
reset_host "DEPLOY_SHA=stackwidesha" "POSTERIZE_SHA=posterizepin"
deploy --service mithril -y
rc=$?
check "exits 0" test $rc -eq 0
check "pins the named service" host_env_has "MITHRIL_SHA=$SHA"
# The regression: scp of the local .env drops the pins, so an unrestored
# DEPLOY_SHA left every other service resolving to :latest after a reboot.
check "preserves the stack-wide pin" host_env_has "DEPLOY_SHA=stackwidesha"
check "preserves another service's pin" host_env_has "POSTERIZE_SHA=posterizepin"
check "does not reap other services" \
  bash -c '! grep -q -- "--remove-orphans" "$0"' "$DOCKER_LOG"

echo "full deploy clears per-service pins"
reset_host "DEPLOY_SHA=stackwidesha" "POSTERIZE_SHA=posterizepin"
deploy -y
check "removes the per-service pin from .env" host_env_lacks POSTERIZE_SHA
# Guard the next check against passing vacuously: if the deploy died before
# compose ran, an empty log would satisfy the absence assertion below.
check "reaches compose" test -s "$DOCKER_LOG"
# export cannot unset, so exporting .env before the rewrite left a cleared pin
# in the environment, where compose prefers it over the file.
check "cleared pin is absent from compose's environment" \
  bash -c '! grep -q "POSTERIZE_SHA=posterizepin" "$0"' "$DOCKER_LOG"

echo "unpublished commit"
reset_host "DEPLOY_SHA=stackwidesha"
FAKE_MISSING_IMAGES="ghcr.io/muchq/mithril" deploy -y
rc=$?
check "refuses to deploy" test $rc -ne 0
check "names the missing image" grep -q "ghcr.io/muchq/mithril" "$WORK/out.txt"
check "leaves the host untouched" host_env_has "DEPLOY_SHA=stackwidesha"
check "runs no compose commands" test ! -s "$DOCKER_LOG"

echo "rollback to an older commit"
reset_host "DEPLOY_SHA=$SHA"
deploy --sha "$OLD_SHA" -y
check "pins to the older commit" host_env_has "DEPLOY_SHA=$OLD_SHA"

echo "listings"
reset_host "DEPLOY_SHA=$SHA"
deploy --list 3
check "lists the requested number of commits" \
  test "$(tail -n +2 "$WORK/out.txt" | wc -l)" -eq 3
check "shows PR numbers from commit subjects" grep -q "(#1003)" "$WORK/out.txt"
check "marks the deployed commit" grep -q -- "<- deployed" "$WORK/out.txt"
deploy --services
check "lists every pinned service" \
  test "$(tail -n +2 "$WORK/out.txt" | wc -l)" -eq \
  "$(grep -c 'image: ghcr.io/muchq/' "$REPO/deploy/consolidated/compose.yaml")"

echo "listing by service"
MID_SHA=$(git -C "$TESTROOT" rev-parse "origin/main~1")
# <content> must be hex: it is served as a digest, and the parser under test
# reads a non-hex one as no digest at all — which is "no image", not an error.
published() { # published <service> <sha> <content>
  mkdir -p "$IMAGES"
  printf '%s\n' "$3" > "$IMAGES/$1_$2"
}
# Listing rows start with a nine-character sha; the title, header, progress
# line and trailer do not.
stdout_rows() { grep -cE '^[0-9a-f]{9}  ' "$WORK/out.txt"; }

# mithril's image changed at the middle commit and not since; posterize's
# never changed. The service's own pin, not the stack-wide one, is what a
# targeted listing marks.
rm -rf "$IMAGES"
published mithril "$SHA" aaa
published mithril "$MID_SHA" aaa
published mithril "$OLD_SHA" bbb
published mithril "$OLDEST_SHA" bbb
published posterize "$SHA" eee
published posterize "$MID_SHA" eee
published posterize "$OLD_SHA" eee
published posterize "$OLDEST_SHA" eee
reset_host "DEPLOY_SHA=$SHA" "MITHRIL_SHA=$MID_SHA"
deploy --list --service mithril
rc=$?
check "exits 0" test $rc -eq 0
check "names the service in the title" grep -q "changed the mithril image" "$WORK/out.txt"
check "lists the commit whose image differs from the one before" grep -q "(#1002)" "$WORK/out.txt"
check "does not list a commit whose image is the same as before" \
  bash -c '! grep -q "(#1003)" "$0"' "$WORK/out.txt"
check "lists the commit where the image first appeared" grep -q "(#1000).*first image" "$WORK/out.txt"
check "and nothing in between" test "$(stdout_rows)" -eq 2
check "marks the service's own deployed revision" grep -q "(#1002).*<- deployed" "$WORK/out.txt"
check "mints one token for the whole scan" test "$(grep -c '^token' "$REGISTRY_LOG")" -eq 1
check "reads the tag list once" test "$(grep -c '^tags mithril' "$REGISTRY_LOG")" -eq 1
check "reads only the commits the tag list names, plus the running one" \
  test "$(grep -c '^manifest' "$REGISTRY_LOG")" -eq 5
FAKE_TAG_PAGE=2 deploy --list --service mithril
check "a paged tag list is followed to its end" grep -q "(#1000).*first image" "$WORK/out.txt"
check "across every page" test "$(grep -c '^tags mithril' "$REGISTRY_LOG")" -eq 2
FAKE_STALE_TOKEN=1 deploy --list --service mithril
check "a 401 remints the token and the listing continues" test $? -eq 0
check "with a second token" test "$(grep -c '^token' "$REGISTRY_LOG")" -eq 2
check "and the same rows" grep -q "(#1002).*<- deployed" "$WORK/out.txt"
check "every manifest read carries the token" \
  test "$(grep -c '^manifest.*\[Authorization: Bearer t\]' "$REGISTRY_LOG")" -eq "$(grep -c '^manifest' "$REGISTRY_LOG")"
check "and asks for a manifest, not an index" \
  bash -c '! grep "^manifest" "$0" | grep -v "manifest.v2+json" | grep -q .' "$REGISTRY_LOG"

# The stack-wide deploy put the newest commit on the host; its mithril image
# is the one the middle commit introduced, so that is the row a rollback
# would move away from.
reset_host "DEPLOY_SHA=$SHA"
deploy --list --service mithril
check "marks the change the running image came from, not the pinned commit" \
  grep -q "(#1002).*<- deployed" "$WORK/out.txt"

deploy --list --service posterize
check "a service that never changed lists only its first image" test "$(stdout_rows)" -eq 1

# A revert: the running image's content appears at two change points, and
# only the one it came from is marked.
published mithril "$SHA" bbb
published mithril "$MID_SHA" aaa
published mithril "$OLD_SHA" bbb
published mithril "$OLDEST_SHA" bbb
reset_host "DEPLOY_SHA=$SHA"
deploy --list --service mithril
check "a reverted image is marked once, at the change it came from" \
  test "$(grep -c -- '<- deployed' "$WORK/out.txt")" -eq 1
check "and that is the newest change with that content" grep -q "(#1003).*<- deployed" "$WORK/out.txt"
published mithril "$SHA" aaa
reset_host "DEPLOY_SHA=$SHA" "MITHRIL_SHA=$MID_SHA"
deploy --list 1 --service mithril
check "COUNT bounds the listing" test "$(stdout_rows)" -eq 1
check "to the newest change" grep -q "(#1002)" "$WORK/out.txt"

# The middle commit's publish failed: the newest is compared with the older
# one, and the row says the change may sit in the gap. The change below it
# has no gap, and says nothing.
rm -f "$IMAGES/mithril_$MID_SHA"
published mithril "$SHA" ccc
published mithril "$OLDEST_SHA" aaa
reset_host "DEPLOY_SHA=$SHA"
deploy --list --service mithril
check "a commit with no image is skipped over" \
  grep -q "(#1003).*or in the 1 commit(s) between, which have no image" "$WORK/out.txt"
check "and not listed itself" bash -c '! grep -q "(#1002)" "$0"' "$WORK/out.txt"
check "and never asked for" bash -c '! grep -q "^manifest mithril $1" "$0"' "$REGISTRY_LOG" "$MID_SHA"
check "a change with no gap carries no gap note" \
  bash -c 'grep "(#1001)" "$0" | grep -qv "between"' "$WORK/out.txt"
published mithril "$OLDEST_SHA" bbb

# The newest commit's publish has not landed yet: it is not a gap in
# anything, and the first change listed is not charged with it.
rm -f "$IMAGES/mithril_$SHA"
published mithril "$MID_SHA" ccc
deploy --list --service mithril
check "an unpublished head is not counted as a gap" \
  bash -c 'grep "(#1002)" "$0" | grep -qv "between"' "$WORK/out.txt"
published mithril "$SHA" ccc

# Two changes, one asked for: the listing stops at the newest.
published mithril "$MID_SHA" aaa
deploy --list 1 --service mithril
check "COUNT stops the listing after one change" test "$(stdout_rows)" -eq 1
check "and that change is the newest" grep -q "(#1003)" "$WORK/out.txt"

# The scan runs out before the oldest commit: the last one seen cannot be
# judged, and the listing says so instead of guessing.
published mithril "$MID_SHA" ccc
DEPLOY_LIST_SCAN=2 deploy --list --service mithril
check "an unjudged commit at the scan limit is reported" grep -q "not compared" "$WORK/out.txt"
check "and not listed as a change" test "$(stdout_rows)" -eq 0
DEPLOY_LIST_SCAN=4 deploy --list --service mithril
check "a scan that ends exactly at history's end still finds the first image" \
  grep -q "(#1000).*first image" "$WORK/out.txt"

# A service introduced recently: nothing older has an image, so the scan
# cap is not what stopped the listing and the tag list says so.
rm -f "$IMAGES/mithril_$MID_SHA" "$IMAGES/mithril_$OLD_SHA" "$IMAGES/mithril_$OLDEST_SHA"
DEPLOY_LIST_SCAN=2 deploy --list --service mithril
check "a service newer than the scan is reported as first appearing" \
  grep -q "(#1003).*first image" "$WORK/out.txt"
check "and not as a scan limit" bash -c '! grep -q "not compared" "$0"' "$WORK/out.txt"

# The scan ends inside an imageless streak but an older image exists beyond
# it: that older image may differ, so the last commit seen is not compared,
# not called the first.
published mithril "$OLDEST_SHA" bbb
DEPLOY_LIST_SCAN=3 deploy --list --service mithril
check "a scan ending on imageless commits with an image beyond is not compared" \
  grep -q "not compared" "$WORK/out.txt"
check "and does not call it the first image" bash -c '! grep -q "first image" "$0"' "$WORK/out.txt"
DEPLOY_LIST_SCAN=4 deploy --list --service mithril
check "one commit further, the change is found across the gap" \
  grep -q "(#1003).*or in the 2 commit(s) between" "$WORK/out.txt"

# No image anywhere in the scan: an answer, not an empty listing.
rm -rf "$IMAGES"
mkdir -p "$IMAGES"
deploy --list --service mithril
check "a service with no image in the scan fails" test $? -ne 0
check "and says so" grep -q "No image published for mithril" "$WORK/out.txt"

published mithril "$SHA" aaa
published mithril "$MID_SHA" aaa
published mithril "$OLD_SHA" bbb
published mithril "$OLDEST_SHA" bbb
FAKE_REGISTRY_DOWN=2 deploy --list --service mithril
check "a registry error fails the listing" test $? -ne 0
check "and says so" grep -q "registry returned 503" "$WORK/out.txt"
check "and prints no rows that would look like a whole history" \
  bash -c '! grep -q "^COMMIT" "$0"' "$WORK/out.txt"

FAKE_NO_REPO=1 deploy --list --service mithril
check "a service the registry has no repository for fails" test $? -ne 0
check "and says what was refused" grep -q "no pull token for muchq/mithril" "$WORK/out.txt"

echo "status"
reset_host "DEPLOY_SHA=$SHA" "POSTERIZE_SHA=posterizepin"
FAKE_PS="games_hub|ghcr.io/muchq/games_hub:$SHA|Up 2 hours
posterize|ghcr.io/muchq/posterize:posterizepin|Up 5 minutes
caddy|caddy:2-alpine|Up 2 hours" \
  FAKE_RESTARTS="games_hub|0
posterize|0
caddy|0" deploy --status
rc=$?
check "exits 0 when everything is healthy and matching" test $rc -eq 0
check "reports the running revision" grep -q "games_hub .*${SHA:0:7}" "$WORK/out.txt"
check "honours a per-service pin" grep -q "posterize .*posterizepin" "$WORK/out.txt"
check "includes third-party containers" grep -q "caddy .*2-alpine" "$WORK/out.txt"

# A container the deploy didn't recreate keeps its old image while .env claims
# the new one — the divergence --status exists to surface.
reset_host "DEPLOY_SHA=$SHA"
FAKE_PS="games_hub|ghcr.io/muchq/games_hub:$SHA|Up 2 hours
mithril|ghcr.io/muchq/mithril:$OLD_SHA|Up 3 days" \
  FAKE_RESTARTS="games_hub|0
mithril|0" deploy --status
rc=$?
check "fails when a container drifted from .env" test $rc -ne 0
check "names the drifted service" grep -q "mithril" "$WORK/out.txt"
check "shows what .env expected" grep -q "\.env says ${SHA:0:7}" "$WORK/out.txt"

# The shape of the incident this all came from: right revision, but the
# container can't stay up. A climbing restart count is the tell.
reset_host "DEPLOY_SHA=$SHA"
FAKE_PS="games_hub|ghcr.io/muchq/games_hub:$SHA|Up 2 hours
posterize|ghcr.io/muchq/posterize:$SHA|Restarting (101) 8 seconds ago" \
  FAKE_RESTARTS="games_hub|0
posterize|47" deploy --status
rc=$?
check "fails when a container is not up" test $rc -ne 0
check "shows the restart count" grep -qE "posterize .*47" "$WORK/out.txt"
check "surfaces the exit code from the state" grep -q "Restarting (101)" "$WORK/out.txt"
check "calls out the crash loop" grep -q "crash loop" "$WORK/out.txt"
check "reports a healthy peer as 0 restarts" grep -qE "games_hub .*0 " "$WORK/out.txt"

echo "portability"
# deploy.sh runs from a developer machine, and macOS still ships bash 3.2 as
# /bin/bash — no associative arrays, no case-conversion expansions, no negative
# array indices. CI runs bash 5, so only a static check catches this.
# Comments are stripped first so prose about these constructs doesn't trip it.
bash4_only=$(sed 's/#.*//' "$REPO/deploy/consolidated/deploy.sh" "$REPO/scripts/image-lib.sh" |
  grep -nE 'declare -A|\$\{[A-Za-z_][A-Za-z0-9_]*\^\^|\$\{[A-Za-z_][A-Za-z0-9_]*,,|\bmapfile\b|\breadarray\b|\[-1\]' || true)
check "no bash 4+ only syntax" test -z "$bash4_only"
[ -n "$bash4_only" ] && printf '%s\n' "$bash4_only" | sed 's/^/          /'

echo "argument handling"
deploy --service nope -y
check "rejects an unknown service" test $? -ne 0
deploy --sha definitelynotacommit -y
check "rejects an unknown commit" test $? -ne 0
deploy --bogus
check "rejects an unknown flag" test $? -ne 0

echo
if [ "$FAILURES" -eq 0 ]; then
  echo "all deploy.sh checks passed"
else
  echo "$FAILURES check(s) failed"
fi
exit $((FAILURES > 0))
