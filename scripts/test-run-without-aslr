#!/bin/bash
# Pins the TSan ASLR escape hatch: tests under --config=tsan must start with
# ADDR_NO_RANDOMIZE so ThreadSanitizer can remap its shadow memory. Without
# that, CI aborts before any race check with "incompatible memory layout but
# was unable to disable ASLR" (PR #1706). The load-bearing pieces are the
# wrapper, its sh_binary, and the test:tsan --run_under line in .bazelrc.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() {
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}

echo "tsan ASLR run-under"

check ".bazelrc routes tsan tests through //scripts:run_without_aslr" \
  grep -qx 'test:tsan --run_under=//scripts:run_without_aslr' "$REPO/.bazelrc"

check "scripts/BUILD.bazel declares the run_without_aslr binary" \
  grep -q 'name = "run_without_aslr"' "$REPO/scripts/BUILD.bazel"

WRAPPER=$REPO/scripts/run_without_aslr.sh
check "the wrapper script exists and is executable" \
  test -x "$WRAPPER"

case "$(uname -s)" in
  Linux)
    # ADDR_NO_RANDOMIZE is 0x0040000. Without the flag, personality is 0 on a
    # stock Linux; with setarch -R it must be set. Skip the positive check
    # when setarch is missing — the wrapper then becomes a no-op by design,
    # and CI's ubuntu image is what has to carry util-linux.
    if command -v setarch >/dev/null 2>&1; then
      PERSONA=$("$WRAPPER" python3 -c 'import ctypes; print(ctypes.CDLL(None).personality(0xffffffff))')
      check "wrapper sets ADDR_NO_RANDOMIZE (personality & 0x40000)" \
        test $((PERSONA & 0x40000)) -ne 0
    else
      echo "  skip  setarch not installed; wrapper no-op path untested here"
    fi
    ;;
  *)
    echo "  skip  non-Linux; wrapper is a no-op and TSan ASLR is a Linux CI concern"
    ;;
esac

if [ "$FAILURES" -ne 0 ]; then
  echo "$FAILURES failure(s)"
  exit 1
fi
echo "all passed"
