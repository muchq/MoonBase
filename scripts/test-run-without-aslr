#!/bin/bash
# Pins the TSan ASLR escape hatch: tests under --config=tsan must start with
# ADDR_NO_RANDOMIZE so ThreadSanitizer can remap its shadow memory. Without
# that, CI aborts before any race check with "incompatible memory layout but
# was unable to disable ASLR" (PR #1706).
#
# Load-bearing pieces: the wrapper under bazel/, its sh_binary, test:tsan
# --run_under and --strategy=TestRunner=local in .bazelrc (the test process
# must run unsandboxed; compiles must not, or the hermetic glibc's start.S
# finds glibc's #error-stub bits/wordsize.h), and seccomp=unconfined on the
# sanitize job (Docker's default profile blocks personality(2), so setarch -R
# returns EPERM). The binary is not under scripts/ — that directory must stay
# unpackaged so root can export //:scripts/... for deploy dry-runs.
#
# Set REQUIRE_ASLR_CLEAR=1 (sanitize tsan leg) to fail when setarch cannot
# clear ASLR. Elsewhere EPERM is a skip — the wiring pins still run.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() {
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}

echo "tsan ASLR run-under"

check ".bazelrc routes tsan tests through //bazel:run_without_aslr" \
  grep -qx 'test:tsan --run_under=//bazel:run_without_aslr' "$REPO/.bazelrc"

check ".bazelrc runs tsan's test runner unsandboxed" \
  grep -qx 'test:tsan --strategy=TestRunner=local' "$REPO/.bazelrc"

check ".bazelrc leaves compiles sandboxed under every config" \
  bash -c '! grep -qE "^[^#]*--(spawn_strategy|strategy=[A-Za-z]*Compile[A-Za-z]*)[= ]+(local|standalone)" "$1"' _ "$REPO/.bazelrc"

check "bazel/BUILD.bazel declares the run_without_aslr binary" \
  grep -q 'name = "run_without_aslr"' "$REPO/bazel/BUILD.bazel"

check "scripts/ stays unpackaged so root //:scripts/... exports keep working" \
  test ! -e "$REPO/scripts/BUILD.bazel"

WRAPPER=$REPO/bazel/run_without_aslr.sh
check "the wrapper script exists and is executable" \
  test -x "$WRAPPER"

# The sanitize job must lift Docker's default seccomp or setarch -R is EPERM
# and every TSan test dies before running.
check "sanitize job allows personality via seccomp=unconfined" \
  grep -q 'seccomp=unconfined' "$REPO/.github/workflows/branch.yml"

case "$(uname -s)" in
  Linux)
    if ! command -v setarch >/dev/null 2>&1; then
      if [ "${REQUIRE_ASLR_CLEAR:-0}" = 1 ]; then
        fail "setarch is required here but not installed"
      else
        echo "  skip  setarch not installed; wrapper no-op path untested here"
      fi
    else
      SETARCH_ERR=$(mktemp)
      PERSONA=$("$WRAPPER" python3 -c 'import ctypes; print(ctypes.CDLL(None).personality(0xffffffff))' 2>"$SETARCH_ERR") || true
      if grep -q 'Operation not permitted' "$SETARCH_ERR"; then
        rm -f "$SETARCH_ERR"
        if [ "${REQUIRE_ASLR_CLEAR:-0}" = 1 ]; then
          fail "setarch -R is EPERM; sanitize needs seccomp=unconfined"
        else
          echo "  skip  setarch -R is EPERM here; sanitize job opts lift seccomp"
        fi
      else
        rm -f "$SETARCH_ERR"
        check "wrapper sets ADDR_NO_RANDOMIZE (personality & 0x40000)" \
          test $((PERSONA & 0x40000)) -ne 0
      fi
    fi
    ;;
  *)
    echo "  skip  non-Linux; wrapper is a no-op and TSan ASLR is a Linux CI concern"
    ;;
esac

if [ "$FAILURES" -ne 0 ]; then
  echo "$FAILURES failure(s)"
  exit 1
fi
echo "all passed"
