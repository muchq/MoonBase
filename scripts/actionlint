#!/bin/bash
# Lint the GitHub Actions workflows: actionlint over .github/workflows, with
# shellcheck over every run block in the shell the workflow declares.
#
# Usage: actionlint [WORKFLOW...]      (default: every workflow)
#
# The shell matters more than the linter: GitHub runs a container job under
# sh unless the workflow says otherwise, while actionlint assumes bash unless
# told. A bash-only line in an undeclared container job is invisible to the
# linter and fatal in CI — twice now (#1061, #1515). So a workflow with a
# container job has to declare its shell, and this refuses one that does not.
#
# Pinned binaries, fetched once into a cache and verified, so the local run
# and the CI run lint with the same versions.
set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
ACTIONLINT_VERSION=1.7.12
SHELLCHECK_VERSION=0.11.0
CACHE=${ACTIONLINT_CACHE:-/tmp/actionlint-$ACTIONLINT_VERSION-shellcheck-$SHELLCHECK_VERSION}

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    ACTIONLINT_ASSET=actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz
    ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
    SHELLCHECK_ASSET=shellcheck-v${SHELLCHECK_VERSION}.linux.x86_64.tar.xz
    SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
    ;;
  Darwin-arm64)
    ACTIONLINT_ASSET=actionlint_${ACTIONLINT_VERSION}_darwin_arm64.tar.gz
    ACTIONLINT_SHA256=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f
    SHELLCHECK_ASSET=shellcheck-v${SHELLCHECK_VERSION}.darwin.aarch64.tar.xz
    SHELLCHECK_SHA256=56affdd8de5527894dca6dc3d7e0a99a873b0f004d7aabc30ae407d3f48b0a79
    ;;
  *)
    echo "ERROR: no pinned actionlint/shellcheck for $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

# fetch <url> <sha256> <dest>: download once, verify always.
fetch() {
  local url=$1 sha=$2 dest=$3
  if [ ! -f "$dest" ]; then
    curl -fsSL -o "$dest.part" "$url"
    mv "$dest.part" "$dest"
  fi
  echo "$sha  $dest" | shasum -a 256 -c - >/dev/null || {
    rm -f "$dest"
    echo "ERROR: checksum mismatch for $url" >&2
    exit 1
  }
}

mkdir -p "$CACHE"
if [ ! -x "$CACHE/actionlint" ]; then
  fetch "https://github.com/rhysd/actionlint/releases/download/v$ACTIONLINT_VERSION/$ACTIONLINT_ASSET" \
    "$ACTIONLINT_SHA256" "$CACHE/$ACTIONLINT_ASSET"
  tar -xzf "$CACHE/$ACTIONLINT_ASSET" -C "$CACHE" actionlint
fi
if [ ! -x "$CACHE/shellcheck" ]; then
  fetch "https://github.com/koalaman/shellcheck/releases/download/v$SHELLCHECK_VERSION/$SHELLCHECK_ASSET" \
    "$SHELLCHECK_SHA256" "$CACHE/$SHELLCHECK_ASSET"
  tar -xJf "$CACHE/$SHELLCHECK_ASSET" -C "$CACHE" --strip-components=1 "shellcheck-v$SHELLCHECK_VERSION/shellcheck"
fi

if [ $# -gt 0 ]; then
  WORKFLOWS=("$@")
else
  WORKFLOWS=("$REPO"/.github/workflows/*.yml)
fi

# A container job runs sh unless the workflow declares its shell, and the
# linter cannot tell. Declared once for the workflow, under defaults.
undeclared=0
for wf in "${WORKFLOWS[@]}"; do
  grep -q '^ *container:' "$wf" || continue
  awk '/^defaults:/{d=1; next} /^[^ ]/{d=0} d && /^ *shell: *bash *$/{found=1} END{exit !found}' "$wf" && continue
  echo "$wf: has a container job but does not declare 'defaults: run: shell: bash'; the job would run under sh" >&2
  undeclared=$((undeclared + 1))
done
[ "$undeclared" -eq 0 ] || exit 1

cd "$REPO"
exec "$CACHE/actionlint" -shellcheck "$CACHE/shellcheck" "${WORKFLOWS[@]}"
