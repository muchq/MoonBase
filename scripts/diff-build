#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=diff-build-lib.sh
source "$SCRIPT_DIR/diff-build-lib.sh"

BASE_REVISION=${1:-"origin/main"}
require_base_revision "$BASE_REVISION"

CURRENT_REF=$(current_ref)

# 1. Formatting Check (Keep this, it's good practice)
bazel test //:buildifier_test || { echo "Run bazel run //:buildifier_fix"; exit 1; }

echo "--- [diff-build] BASE_REVISION=$BASE_REVISION  CURRENT_REF=$CURRENT_REF"

# 2. Config or shared macros changed: bazel-diff isn't reliable; full build/test.
FULL_BUILD_CHANGES=$(paths_forcing_full_build "$BASE_REVISION")
if [ -n "$FULL_BUILD_CHANGES" ]; then
  echo "Bazel config or shared build macros changed; running full build and test..."
  echo "$FULL_BUILD_CHANGES" | sed 's/^/  /'
  bazel build //... || exit 1
  bazel test --config=ci //... || exit 1
  exit 0
fi

# 3. Impacted targets from bazel-diff.
bazel_diff_impacted "$BASE_REVISION" /tmp/impacted_targets.txt

# 4. Smart Build/Test using Bazel Query
# Instead of complex bash loops, we use Bazel's own query engine to
# categorize the targets into "tests" and "not tests".
if [ -s /tmp/impacted_targets.txt ]; then
    # Filter to first-party targets only — bazel-diff may include external targets
    # (e.g. @@rules_cc++//:foo) which are invalid in bazel query set() expressions.
    grep '^//' /tmp/impacted_targets.txt > /tmp/impacted_targets_filtered.txt || true
    echo "--- [diff-build] first-party impacted targets: $(wc -l < /tmp/impacted_targets_filtered.txt)"

    build_and_test_impacted /tmp/impacted_targets_filtered.txt \
      /tmp/impacted_tests.txt /tmp/impacted_builds.txt
else
    echo "No changes detected."
fi
echo "--- [diff-build] done."
