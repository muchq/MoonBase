#!/bin/bash
# Pins scripts/plist-string, which the wordchains-ios release reads its
# version with. It runs on Linux, so no PlistBuddy, and an unreadable version
# must fail rather than print nothing: nothing compares equal to nothing, and
# the release would report "unchanged" forever.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
SUBJECT=$REPO/scripts/plist-string
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() {
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}
prints() { [ "$("$SUBJECT" "$2" "$3" 2>/dev/null)" = "$1" ]; }
refuses() { ! out=$("$SUBJECT" "$1" "$2" 2>/dev/null) && [ -z "$out" ]; }

echo "plist-string"

cat >"$WORK/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<key>CFBundleShortVersionString</key>
	<string>1.2.3</string>
	<key>CFBundleVersion</key>
	<string>7</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>Empty</key>
	<string></string>
</dict>
</plist>
PLIST

check "reads a string value" prints 1.2.3 "$WORK/Info.plist" CFBundleShortVersionString
check "reads the key asked for, not a neighbour" prints 7 "$WORK/Info.plist" CFBundleVersion
check "refuses a missing key" refuses "$WORK/Info.plist" NoSuchKey
check "refuses a key whose value is not a string" refuses "$WORK/Info.plist" LSRequiresIPhoneOS
check "refuses an empty string" refuses "$WORK/Info.plist" Empty
check "refuses a missing file" refuses "$WORK/missing.plist" CFBundleShortVersionString
check "reads the app's own version" grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' \
  <<<"$("$SUBJECT" "$REPO/domains/games/apps/wordchains_ios/Info.plist" CFBundleShortVersionString)"

if [ "$FAILURES" -ne 0 ]; then
  echo "$FAILURES failure(s)"
  exit 1
fi
