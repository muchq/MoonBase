#!/bin/bash
# Pins which path changes force the sanitize matrix on, which of those widen
# it to every sanitizable test instead of trusting bazel-diff, and how the
# impacted set narrows the targets. No real workspace and no real bazel: a
# throwaway repo with a base commit and a HEAD that touches one file, driven
# through scripts/sanitize-needed and the functions in sanitize-needed-lib.sh.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
DECIDE=${DECIDE:-$REPO/scripts/sanitize-needed}
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() {
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}
out_lacks_true() { ! grep -qx true "$1"; }
# fails_saying <pattern> <cmd...>: cmd exits non-zero and says why.
fails_saying() {
  local pattern=$1 err
  shift
  if err=$("$@" 2>&1 >/dev/null); then return 1; fi
  grep -q "$pattern" <<<"$err"
}

# ------------------------------------------------------------------ fixture

FIXTURE=$WORK/repo
mkdir -p "$FIXTURE"
cd "$FIXTURE"
git init -q
git config user.email "test@example.com"
git config user.name "test"
# A global commit.gpgsign=true would demand the developer's key for fixture commits.
git config commit.gpgsign false

# Minimal tree so every pathspec we care about exists on the base.
mkdir -p bazel/rules domains/games/libs/demo
printf '9.0.0\n' > .bazelversion
printf 'build --foo\n' > .bazelrc
printf '# macros\n' > bazel/rules/java.bzl
printf '# package\n' > bazel/rules/BUILD.bazel
printf 'module\n' > MODULE.bazel
printf 'llvm\n' > bazel/tools.MODULE.bazel
printf 'cc\n' > domains/games/libs/demo/demo.cc
printf 'h\n' > domains/games/libs/demo/demo.h
printf 'build\n' > domains/games/libs/demo/BUILD.bazel
printf 'readme\n' > README.md
printf 'java\n' > domains/games/Hello.java
git add .
git commit -q -m base
BASE=$(git rev-parse HEAD)

decide() {
  "$DECIDE" "$BASE"
}

commit_change_to() { # commit_change_to <path> <contents>
  local path=$1 contents=$2
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$contents" > "$path"
  git add "$path"
  git commit -q -m "change $path"
}

reset_to_base() {
  git checkout -q "$BASE"
  git reset -q --hard "$BASE"
}

# ------------------------------------------------------------------ cases

echo "sanitize pathspecs"

reset_to_base
commit_change_to README.md 'readme changed'
check "an unrelated file keeps sanitizers off" \
  test "$(decide)" = "false"

reset_to_base
commit_change_to domains/games/Hello.java 'java changed'
check "a Java-only domain change keeps sanitizers off" \
  test "$(decide)" = "false"

reset_to_base
commit_change_to domains/games/libs/demo/demo.cc 'cc changed'
check "a .cc change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/libs/demo/demo.h 'h changed'
check "a .h change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/libs/demo/BUILD.bazel 'build changed'
check "a domains BUILD.bazel change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/libs/demo/defs.bzl '# macros'
check "a domains .bzl change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/protos/cards.proto 'syntax = "proto3";'
check "a domains .proto change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to .bazelrc 'build --bar'
check "a .bazelrc change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to .bazelversion '9.1.1'
check "a .bazelversion bump turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to MODULE.bazel 'module changed'
check "a MODULE.bazel change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to bazel/tools.MODULE.bazel 'llvm pin bumped'
check "a bazel/*.MODULE.bazel change turns sanitizers on" \
  test "$(decide)" = "true"

# oci.MODULE.bazel pins container digests; that forces a full build for
# bazel-diff, but it does not change C++ sanitizer codegen. Keep sanitize
# off so a Java base-image bump is not held by the TSan matrix.
reset_to_base
commit_change_to bazel/oci.MODULE.bazel 'digest bumped'
check "an oci.MODULE.bazel digest pin keeps sanitizers off" \
  test "$(decide)" = "false"

reset_to_base
commit_change_to bazel/rules/java.bzl '# macros changed'
check "a bazel/rules *.bzl change turns sanitizers on" \
  test "$(decide)" = "true"

echo "full vs bazel-diff"

# shellcheck source=sanitize-needed-lib.sh
source "$REPO/scripts/sanitize-needed-lib.sh"
mode() { sanitize_mode "$BASE"; }

reset_to_base
commit_change_to domains/games/libs/demo/demo.cc 'cc changed'
check "a .cc change trusts bazel-diff" test "$(mode)" = "diff"

reset_to_base
commit_change_to domains/games/libs/demo/BUILD.bazel 'build changed'
check "a domains BUILD.bazel change trusts bazel-diff" test "$(mode)" = "diff"

reset_to_base
commit_change_to .bazelrc 'build --bar'
check "a .bazelrc change sanitizes everything" test "$(mode)" = "full"

reset_to_base
commit_change_to bazel/tools.MODULE.bazel 'llvm pin bumped'
check "a toolchain pin sanitizes everything" test "$(mode)" = "full"

reset_to_base
commit_change_to bazel/rules/java.bzl '# macros changed'
check "a shared macro change sanitizes everything" test "$(mode)" = "full"

reset_to_base
commit_change_to bazel/oci.MODULE.bazel 'digest bumped'
check "an oci digest pin does not sanitize everything" test "$(mode)" = "diff"

echo "target selection"

UNIVERSE=$WORK/universe.txt
IMPACTED=$WORK/impacted.txt
SELECTED=$WORK/selected.txt
printf '%s\n' //domains/a:a_test //domains/b:b_test > "$UNIVERSE"

select_sanitize_targets "$UNIVERSE" - "$SELECTED"
check "full mode selects the whole universe" \
  diff -q "$UNIVERSE" "$SELECTED"

printf '%s\n' //domains/a:a_lib //domains/a:a_test @@rules_cc+//:x \
  //domains/excluded:pg_test > "$IMPACTED"
select_sanitize_targets "$UNIVERSE" "$IMPACTED" "$SELECTED"
check "diff mode selects only impacted tests in the universe" \
  test "$(cat "$SELECTED")" = "//domains/a:a_test"

: > "$IMPACTED"
echo //stale:out > "$SELECTED"
select_sanitize_targets "$UNIVERSE" "$IMPACTED" "$SELECTED"
check "nothing impacted selects nothing" test ! -s "$SELECTED"

printf '%s\n' //domains/a:a_lib > "$IMPACTED"
echo //stale:out > "$SELECTED"
select_sanitize_targets "$UNIVERSE" "$IMPACTED" "$SELECTED"
check "an impacted non-test selects nothing" test ! -s "$SELECTED"

: > "$UNIVERSE"
printf '%s\n' //domains/a:a_test > "$IMPACTED"
check "an empty universe fails rather than passing vacuously" \
  fails_saying "universe is empty" select_sanitize_targets "$UNIVERSE" "$IMPACTED" "$SELECTED"
check "an empty universe fails in full mode too" \
  fails_saying "universe is empty" select_sanitize_targets "$UNIVERSE" - "$SELECTED"

echo "base revision resolution"

reset_to_base
commit_change_to domains/games/libs/demo/demo.cc 'still changed under a bad base'
BAD_OUT=$WORK/bad.out
set +e
"$DECIDE" refs/heads/does-not-exist >"$BAD_OUT" 2>&1
BAD_STATUS=$?
set -e
check "an unresolvable base exits non-zero" test "$BAD_STATUS" -ne 0
check "an unresolvable base does not print true" \
  out_lacks_true "$BAD_OUT"

if [ "$FAILURES" -eq 0 ]; then
  echo "All tests passed."
  exit 0
fi
echo "$FAILURES failure(s)."
exit 1
