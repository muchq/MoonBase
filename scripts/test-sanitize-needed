#!/bin/bash
# Pins which path changes force the sanitize matrix on. No real workspace:
# a throwaway repo with a base commit and a HEAD that touches one file,
# driven through scripts/sanitize-needed.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
DECIDE=${DECIDE:-$REPO/scripts/sanitize-needed}
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() {
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}
out_lacks_true() { ! grep -qx true "$1"; }

# ------------------------------------------------------------------ fixture

FIXTURE=$WORK/repo
mkdir -p "$FIXTURE"
cd "$FIXTURE"
git init -q
git config user.email "test@example.com"
git config user.name "test"
# A global commit.gpgsign=true would demand the developer's key for fixture commits.
git config commit.gpgsign false

# Minimal tree so every pathspec we care about exists on the base.
mkdir -p bazel/rules domains/games/libs/demo
printf '9.0.0\n' > .bazelversion
printf 'build --foo\n' > .bazelrc
printf '# macros\n' > bazel/rules/java.bzl
printf '# package\n' > bazel/rules/BUILD.bazel
printf 'module\n' > MODULE.bazel
printf 'llvm\n' > bazel/tools.MODULE.bazel
printf 'cc\n' > domains/games/libs/demo/demo.cc
printf 'h\n' > domains/games/libs/demo/demo.h
printf 'build\n' > domains/games/libs/demo/BUILD.bazel
printf 'readme\n' > README.md
printf 'java\n' > domains/games/Hello.java
git add .
git commit -q -m base
BASE=$(git rev-parse HEAD)

decide() {
  "$DECIDE" "$BASE"
}

commit_change_to() { # commit_change_to <path> <contents>
  local path=$1 contents=$2
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$contents" > "$path"
  git add "$path"
  git commit -q -m "change $path"
}

reset_to_base() {
  git checkout -q "$BASE"
  git reset -q --hard "$BASE"
}

# ------------------------------------------------------------------ cases

echo "sanitize pathspecs"

reset_to_base
commit_change_to README.md 'readme changed'
check "an unrelated file keeps sanitizers off" \
  test "$(decide)" = "false"

reset_to_base
commit_change_to domains/games/Hello.java 'java changed'
check "a Java-only domain change keeps sanitizers off" \
  test "$(decide)" = "false"

reset_to_base
commit_change_to domains/games/libs/demo/demo.cc 'cc changed'
check "a .cc change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/libs/demo/demo.h 'h changed'
check "a .h change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/libs/demo/BUILD.bazel 'build changed'
check "a domains BUILD.bazel change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/libs/demo/defs.bzl '# macros'
check "a domains .bzl change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to domains/games/protos/cards.proto 'syntax = "proto3";'
check "a domains .proto change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to .bazelrc 'build --bar'
check "a .bazelrc change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to .bazelversion '9.1.1'
check "a .bazelversion bump turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to MODULE.bazel 'module changed'
check "a MODULE.bazel change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to bazel/tools.MODULE.bazel 'llvm pin bumped'
check "a bazel/*.MODULE.bazel change turns sanitizers on" \
  test "$(decide)" = "true"

reset_to_base
commit_change_to bazel/rules/java.bzl '# macros changed'
check "a bazel/rules *.bzl change turns sanitizers on" \
  test "$(decide)" = "true"

echo "base revision resolution"

reset_to_base
commit_change_to domains/games/libs/demo/demo.cc 'still changed under a bad base'
BAD_OUT=$WORK/bad.out
set +e
"$DECIDE" refs/heads/does-not-exist >"$BAD_OUT" 2>&1
BAD_STATUS=$?
set -e
check "an unresolvable base exits non-zero" test "$BAD_STATUS" -ne 0
check "an unresolvable base does not print true" \
  out_lacks_true "$BAD_OUT"

if [ "$FAILURES" -eq 0 ]; then
  echo "All tests passed."
  exit 0
fi
echo "$FAILURES failure(s)."
exit 1
