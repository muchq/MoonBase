#!/bin/bash
# Prints "true" if the sanitize matrix should run for changes between
# <base-revision> and HEAD, else "false". Used by the sanitize job in
# .github/workflows/branch.yml; the pathspec list lives in
# sanitize-needed-lib.sh and is pinned by scripts/test-sanitize-needed.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=sanitize-needed-lib.sh
source "$SCRIPT_DIR/sanitize-needed-lib.sh"

BASE_REVISION=${1:?usage: sanitize-needed <base-revision>}
require_base_revision "$BASE_REVISION"
if [ -n "$(paths_needing_sanitize "$BASE_REVISION")" ]; then
  echo "true"
else
  echo "false"
fi
