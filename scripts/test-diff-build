#!/bin/bash
# Pins which path changes force scripts/diff-build onto the full //... path
# instead of trusting bazel-diff (#1378).
#
# The subject under test is a decision over a git diff, so the fixture is a
# throwaway repo with a base commit and a HEAD that touches one file. No bazel
# and no real workspace — scripts/diff-build-decide shares the pathspec list
# and never reaches a build.
set -uo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)
DECIDE=${DECIDE:-$REPO/scripts/diff-build-decide}
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

FAILURES=0
pass() { echo "  ok    $1"; }
fail() {
  echo "  FAIL  $1"
  FAILURES=$((FAILURES + 1))
}
check() {
  local desc=$1
  shift
  if "$@"; then pass "$desc"; else fail "$desc"; fi
}
out_lacks_line() { ! grep -qx "$1" "$2"; }

# ------------------------------------------------------------------ fixture

FIXTURE=$WORK/repo
mkdir -p "$FIXTURE"
cd "$FIXTURE"
git init -q
git config user.email "test@example.com"
git config user.name "test"
# The fixture is its own repo; a signing key configured for this machine is not.
git config commit.gpgsign false

# Minimal tree so every pathspec we care about exists on the base.
mkdir -p bazel/rules/testdata domains/games
printf '9.0.0\n' > .bazelversion
printf 'build --foo\n' > .bazelrc
printf '# macros\n' > bazel/rules/java.bzl
printf '# oci\n' > bazel/rules/oci.bzl
printf '# package\n' > bazel/rules/BUILD.bazel
printf 'probe\n' > bazel/rules/testdata/Probe.java
printf 'image:\n' > bazel/rules/java_image_test.yaml
printf 'readme\n' > README.md
printf 'src\n' > domains/games/hello.txt
git add .
git commit -q -m base
BASE=$(git rev-parse HEAD)

decide() {
  "$DECIDE" "$BASE"
}

commit_change_to() { # commit_change_to <path> <contents>
  local path=$1 contents=$2
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$contents" > "$path"
  git add "$path"
  git commit -q -m "change $path"
}

reset_to_base() {
  git checkout -q "$BASE"
  # Drop any commits above base so each case starts from the same tree.
  git reset -q --hard "$BASE"
}

# --------------------------------------------------------------- cases

echo "full-build pathspecs"

reset_to_base
commit_change_to README.md 'readme changed'
DECISION=$(decide)
check "an unrelated file keeps the bazel-diff path" \
  test "$DECISION" = "diff"

reset_to_base
commit_change_to .bazelversion '9.1.1'
check "a .bazelversion bump forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to .bazelrc 'build --bar'
check "a .bazelrc bump forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to bazel/rules/java.bzl '# macros changed'
check "a shared java.bzl edit forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to bazel/rules/oci.bzl '# oci changed'
check "a shared oci.bzl edit forces a full build (not Java-specific)" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to bazel/rules/BUILD.bazel '# package changed'
check "a bazel/rules BUILD.bazel edit forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to bazel/rules/java_rules_test.bzl '# guard test'
check "a bazel/rules *.bzl edit forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to bazel/smithy.MODULE.bazel '# pin bumped'
check "a module pin bump forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to MODULE.bazel '# dep added'
check "a MODULE.bazel edit forces a full build" \
  test "$(decide)" = "full"

reset_to_base
commit_change_to bazel/rules/testdata/Probe.java 'probe changed'
DECISION=$(decide)
check "a rules testdata fixture keeps the bazel-diff path" \
  test "$DECISION" = "diff"

reset_to_base
commit_change_to bazel/rules/java_image_test.yaml 'image: changed'
DECISION=$(decide)
check "a rules yaml fixture keeps the bazel-diff path" \
  test "$DECISION" = "diff"

reset_to_base
commit_change_to domains/games/hello.txt 'src changed'
DECISION=$(decide)
check "a domain source change keeps the bazel-diff path" \
  test "$DECISION" = "diff"

echo "base revision resolution"

reset_to_base
commit_change_to bazel/rules/java.bzl '# still changed under a bad base'
BAD_OUT=$WORK/bad.out
set +e
"$DECIDE" refs/heads/does-not-exist >"$BAD_OUT" 2>&1
BAD_STATUS=$?
set +e
check "an unresolvable base exits non-zero" test "$BAD_STATUS" -ne 0
check "an unresolvable base does not report diff" \
  out_lacks_line 'diff' "$BAD_OUT"
check "an unresolvable base names the failure" \
  grep -q 'does not resolve' "$BAD_OUT"

echo "impact queries"

# A bazel that records how it was called and answers as told. The subject is
# what reaches its argv: the label set must not, because at a few hundred
# labels an inlined set() exceeds ARG_MAX and the query fails before it runs.
BIN=$WORK/bin
mkdir -p "$BIN"
cat > "$BIN/bazel" <<'EOF'
#!/bin/bash
printf '%s\n' "$@" > "$FAKE_BAZEL_ARGS"
for arg in "$@"; do
  case $arg in --query_file=*) cp "${arg#--query_file=}" "$FAKE_BAZEL_QUERY" ;; esac
done
[ -n "${FAKE_BAZEL_STDERR:-}" ] && echo "$FAKE_BAZEL_STDERR" >&2
[ -n "${FAKE_BAZEL_STDOUT:-}" ] && printf '%s\n' "$FAKE_BAZEL_STDOUT"
exit "${FAKE_BAZEL_STATUS:-0}"
EOF
chmod +x "$BIN/bazel"
export FAKE_BAZEL_ARGS=$WORK/bazel.args FAKE_BAZEL_QUERY=$WORK/bazel.query
export PATH="$BIN:$PATH"
answer() { # answer <stdout> [status] [stderr]
  export FAKE_BAZEL_STDOUT=$1 FAKE_BAZEL_STATUS=${2:-0} FAKE_BAZEL_STDERR=${3:-}
}
# shellcheck source=diff-build-lib.sh
source "$REPO/scripts/diff-build-lib.sh"

TARGETS=$WORK/targets.txt
: > "$TARGETS"
for i in $(seq 1 600); do
  printf '//domains/some/rather/long/package/path/number/%d:a_target_with_a_long_name_%d\n' \
    "$i" "$i" >> "$TARGETS"
done
QUERY=$WORK/query.txt
write_impact_query "$TARGETS" "kind(test, SET) except attr(tags, 'manual', SET)" "$QUERY"
check "the query file names every impacted target, once per SET" \
  test "$(grep -o '//domains' "$QUERY" | wc -l | tr -d ' ')" = "1200"
check "every SET in the template becomes the set" \
  test "$(grep -o 'set(' "$QUERY" | wc -l | tr -d ' ')" = "2"
check "the query is one expression" test "$(wc -l < "$QUERY" | tr -d ' ')" = "1"

answer $'//a:t\n//b:u'
OUT=$(run_impact_query "$QUERY")
check "the labels stay off bazel's command line" \
  out_lacks_line "kind(test, set(//domains" "$FAKE_BAZEL_ARGS"
check "nothing on bazel's command line names a target" \
  test "$(grep -c '//domains' "$FAKE_BAZEL_ARGS")" = "0"
check "bazel reads the query from the file" \
  grep -qx -- "--query_file=$QUERY" "$FAKE_BAZEL_ARGS"
check "the query bazel read is the one written" cmp -s "$QUERY" "$FAKE_BAZEL_QUERY"
check "matching labels are printed one per line" test "$OUT" = $'//a:t\n//b:u'

answer $'Loading: 3 packages loaded\n//a:t'
OUT=$(run_impact_query "$QUERY")
check "only labels are printed, not bazel's progress" test "$OUT" = '//a:t'

answer ''
OUT=$(run_impact_query "$QUERY")
STATUS=$?
check "no match is success" test "$STATUS" -eq 0
check "no match prints nothing" test -z "$OUT"

answer '' 1 'bazel: Argument list too long'
OUT=$(run_impact_query "$QUERY" 2> "$WORK/query.err")
STATUS=$?
check "a query bazel refused is a failure, not an empty set" test "$STATUS" -ne 0
check "the refusal reaches the log" grep -q 'Argument list too long' "$WORK/query.err"

echo
if [ "$FAILURES" -eq 0 ]; then
  echo "all diff-build checks passed"
else
  echo "$FAILURES check(s) failed"
fi
exit $((FAILURES > 0))
