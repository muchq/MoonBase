#!/bin/bash
# Break the code on purpose and check the tests notice.
#
# A green suite proves the tests ran, not that they'd catch anything. Tests
# routinely assert on values that are correct and also the default — a zero
# that means "healthy" and also "the query failed", a name that's right whether
# or not the payload beside it is. Those pass against a broken implementation.
#
# This applies each mutation, runs the tests, and reports the ones that did NOT
# fail. A surviving mutation is a bug the suite would ship.
set -uo pipefail

usage() {
  cat <<'USAGE'
Usage: mutation-check -f FILE -t TEST_CMD MUTATION [MUTATION...]

Applies each MUTATION (a sed expression) to FILE, runs TEST_CMD, and reports
which mutations survived — i.e. which real bugs the tests fail to catch.

Options:
  -f, --file FILE     File to mutate; restored afterwards, including on Ctrl-C
  -t, --test CMD      Test command; must pass before mutating. Runs in a
                      subshell, so a `cd` in it is safe and does not leak
  -h, --help          Show this help

Examples:
  # Does the suite notice if a boundary is wrong?
  scripts/mutation-check -f domains/platform/apis/prom_proxy/handlers.go \
    -t 'go test $(ls domains/platform/apis/prom_proxy/*.go | grep -v /main.go)' \
    's/restartsLastHour >= crashLoopMinRestarts/restartsLastHour > crashLoopMinRestarts/' \
    's/stats.CrashLooping = reporting \&\& isCrashLooping/stats.CrashLooping = isCrashLooping/'

  # Shell works too — the file just has to be text and the command a test run.
  scripts/mutation-check -f deploy/consolidated/deploy.sh -t ./scripts/test-deploy \
    's/--remove-orphans//'

Mutate the behaviour, not the syntax: a change that won't compile is caught by
the compiler and tells you nothing about the tests. Aim at the decisions —
boundaries, guards, which variable feeds a call, an omitted field.

Exits non-zero if any mutation survived, and also if any expression never
applied (SKIPPED, or INVALID with sed's complaint). A run that tested nothing
is not a passing run.
USAGE
}

FILE=""
TEST_CMD=""
MUTATIONS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -f | --file)
      FILE=${2:-}
      shift 2
      ;;
    -t | --test)
      TEST_CMD=${2:-}
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      MUTATIONS+=("$1")
      shift
      ;;
  esac
done

if [ -z "$FILE" ] || [ -z "$TEST_CMD" ] || [ ${#MUTATIONS[@]} -eq 0 ]; then
  usage >&2
  exit 1
fi
if [ ! -f "$FILE" ]; then
  echo "Error: no such file: $FILE" >&2
  exit 1
fi

# Resolve the target before anything else touches it. Every later reference —
# the restore, the sed, the cmp — has to mean the same file no matter what
# directory the shell is standing in by then, and a test command is free to
# move it (see the subshell below). A relative path kept as a string is how a
# restore silently turns into "cp: No such file or directory" (#1369).
FILE=$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")

BACKUP=$(mktemp)
SED_ERR=$(mktemp)
cp "$FILE" "$BACKUP"
restore() { cp "$BACKUP" "$FILE"; }
# Restore on interrupt too: leaving a mutated source behind would be worse
# than the bug being looked for. The signal handler only exits — `exit` fires
# the EXIT trap, which does the restoring and the cleanup. Doing either here as
# well means the EXIT handler then copies from a backup this one just deleted,
# printing a cp error over whatever the user was reading (#1372).
trap 'exit 130' INT TERM
trap 'restore; rm -f "$BACKUP" "$SED_ERR"' EXIT

# Baseline. Without this a suite that's already red makes every mutation look
# caught, which is the most flattering possible wrong answer.
# Every run of the test command goes through a subshell. `eval` alone runs it
# in this shell, so a command containing `cd` — the ordinary way to run a suite
# that lives in a subdirectory — leaves the script somewhere else for the rest
# of the run. That corrupts the restore, and worse, makes the *next* relative
# `cd` fail: the command exits non-zero, and this script reads that as the
# suite catching a mutation. A clean report from an experiment that never ran
# is the one outcome a mutation checker must never produce (#1369).
run_tests() { ( eval "$TEST_CMD" ) > /dev/null 2>&1; }

echo "baseline..."
if ! run_tests; then
  echo "Error: tests fail before any mutation — fix that first, or every" >&2
  echo "mutation will look caught." >&2
  exit 1
fi
echo "  ok, suite is green"
echo

SURVIVED=0
KILLED=0
SKIPPED=0
INVALID=0
for mutation in "${MUTATIONS[@]}"; do
  restore

  # sed's own complaint used to go to /dev/null, which made a malformed
  # expression indistinguishable from one that simply matched nothing — the
  # same SKIPPED line for two different mistakes, only one of which is fixable
  # by looking harder at the source (#1372).
  if ! sed -i.bak "$mutation" "$FILE" 2>"$SED_ERR"; then
    echo "  INVALID  $mutation"
    sed 's/^/           /' "$SED_ERR"
    rm -f "$FILE.bak"
    INVALID=$((INVALID + 1))
    continue
  fi
  rm -f "$FILE.bak"

  # A sed that matched nothing leaves the code intact, so the suite passes and
  # the mutation looks like a survivor. That's a broken experiment, not a
  # finding — say so instead of reporting a false bug.
  if cmp -s "$FILE" "$BACKUP"; then
    echo "  SKIPPED  $mutation"
    echo "           (matched nothing — check the expression)"
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  if run_tests; then
    echo "  SURVIVED $mutation"
    SURVIVED=$((SURVIVED + 1))
  else
    echo "  killed   $mutation"
    KILLED=$((KILLED + 1))
  fi
done

restore
echo
if [ "$SURVIVED" -gt 0 ]; then
  echo "$SURVIVED mutation(s) survived: the tests would ship those bugs."
  echo "Add an assertion that fails on each, then re-run."
  exit 1
fi

# Nothing ran. Reporting that as success is the failure mode this whole script
# exists to prevent, one level up: a green verdict for an experiment that never
# happened, reachable from a single typo in a sed expression (#1372).
if [ "$KILLED" -eq 0 ]; then
  echo "no mutation applied: $SKIPPED matched nothing, $INVALID invalid."
  echo "Nothing was tested — fix the expressions and re-run."
  exit 1
fi

SUMMARY="$KILLED mutation(s) killed"
[ "$SKIPPED" -gt 0 ] && SUMMARY="$SUMMARY, $SKIPPED skipped"
[ "$INVALID" -gt 0 ] && SUMMARY="$SUMMARY, $INVALID invalid"
echo "$SUMMARY"
# A skipped or invalid expression is a question that never got asked. The
# answers that did come back are real, so they are reported above — but the run
# as a whole did not do what it was told, and saying so only in a line someone
# might not read is how a typo becomes a clean bill of health.
if [ "$SKIPPED" -gt 0 ] || [ "$INVALID" -gt 0 ]; then
  echo "Some expressions never applied; the run is incomplete."
  exit 1
fi
