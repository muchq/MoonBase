load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel/rules:oci.bzl", "linux_amd64_oci_binary")

# Read as text by //domains/platform/libs/otel_contract, which pins the
# games_hub vocabulary hub.rs bounds against the hub's own names.
exports_files(["src/hub.rs"])

rust_binary(
    name = "deja",
    srcs = [
        "src/api.rs",
        "src/bigram.rs",
        "src/checkpoint.rs",
        "src/engine.rs",
        "src/hub.rs",
        "src/lanes.rs",
        "src/main.rs",
        "src/metrics.rs",
        "src/net.rs",
        "src/score.rs",
        "src/tail.rs",
        "src/token.rs",
    ],
    crate_name = "deja",
    deps = [
        "//domains/platform/libs/caddylog",
        "//domains/platform/libs/server_pal",
    ] + all_crate_deps(cargo_only = True),
)

rust_test(
    name = "test_deja",
    size = "small",
    crate = ":deja",
    # candle's gemm splits its reductions across rayon threads, so the last
    # digits of a surprise depend on how many the machine has. The float
    # assertions carry margins; this makes them reproducible as well.
    env = {"RAYON_NUM_THREADS": "1"},
    deps = all_crate_deps(normal_dev = True),
)

linux_amd64_oci_binary(bin_name = "deja")
