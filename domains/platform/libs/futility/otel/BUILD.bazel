load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Read as text by //domains/platform/libs/otel_contract, which pins this rail's
# latency bucket bounds and http_server_* descriptions equal to yodel's and
# server_pal's. Label sets and units are pinned behaviorally instead, by
# http_metrics_test and http_instrument_descriptions_test.
exports_files([
    "http_instrument_descriptions.h",
    "otel_provider.h",
])

cc_library(
    name = "otel_provider",
    srcs = ["otel_provider.cc"],
    hdrs = ["otel_provider.h"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_absl//absl/strings",
        "@opentelemetry-cpp//api",
        "@opentelemetry-cpp//exporters/otlp:otlp_http_metric_exporter",
        "@opentelemetry-cpp//sdk/src/metrics",
    ],
)

# The descriptions the shared http_server_* instruments are exported with.
# Header-only and dependency-free so both the recorder that creates the
# instruments and any test can name one declaration site.
cc_library(
    name = "http_instrument_descriptions",
    hdrs = ["http_instrument_descriptions.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "metrics",
    srcs = ["metrics.cc"],
    hdrs = ["metrics.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":http_instrument_descriptions",
        ":otel_provider",
        "@com_google_absl//absl/strings",
        "@opentelemetry-cpp//api",
    ],
)

# The recording test double the virtual methods on MetricsRecorder exist
# for. Shared rather than per-fixture: "this counter fired with this label"
# is an assertion every instrumented service needs, and it was already
# written twice.
cc_library(
    name = "capturing_metrics_recorder",
    testonly = True,
    hdrs = ["capturing_metrics_recorder.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":metrics",
    ],
)

# The shared HTTP serving instruments; transport-agnostic so every HTTP
# service exports the same names and labels regardless of server framework.
cc_library(
    name = "http_metrics",
    srcs = ["http_metrics.cc"],
    hdrs = ["http_metrics.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":metrics",
    ],
)

cc_test(
    name = "otel_provider_test",
    size = "small",
    srcs = ["otel_provider_test.cc"],
    deps = [
        ":otel_provider",
        "@googletest//:gtest_main",
        "@opentelemetry-cpp//exporters/memory:in_memory_metric_data",
        "@opentelemetry-cpp//exporters/memory:in_memory_metric_exporter_factory",
    ],
)

cc_test(
    name = "http_instrument_descriptions_test",
    size = "small",
    srcs = ["http_instrument_descriptions_test.cc"],
    deps = [
        ":http_instrument_descriptions",
        ":metrics",
        ":otel_provider",
        "@googletest//:gtest_main",
        "@opentelemetry-cpp//exporters/memory:in_memory_metric_data",
        "@opentelemetry-cpp//exporters/memory:in_memory_metric_exporter_factory",
    ],
)

cc_test(
    name = "http_metrics_test",
    size = "small",
    srcs = ["http_metrics_test.cc"],
    deps = [
        ":capturing_metrics_recorder",
        ":http_metrics",
        "@googletest//:gtest_main",
    ],
)
