load("@io_bazel_rules_go//go:def.bzl", "go_test")

# Cross-language pins for the metric contract prom_proxy reads. No library and
# no importable code: the sources under test are Java, C++ and Rust, and the
# properties pinned here are the ones that only exist between them.
go_test(
    name = "otel_contract_test",
    size = "small",
    srcs = [
        "classify_vocabulary_test.go",
        "event_log_names_test.go",
        "http_instrument_descriptions_test.go",
        "http_instrument_labels_test.go",
        "http_latency_buckets_test.go",
        "hub_event_vocabulary_test.go",
        "query_event_vocabulary_test.go",
        "request_log_fields_test.go",
        "route_vocabulary_test.go",
    ],
    # Read as text rather than linked. There is no build configuration in which
    # a Go test could link all three, and the declaration site is what has to
    # agree — the constant, not a value some running process reports. Only
    # named-constant declarations are pinned this way; label sets and units
    # are pinned per rail against real exported payloads instead.
    data = [
        "//domains/games/apis/games_hub:game_events.h",
        "//domains/games/apis/games_hub:hosted_game.h",
        "//domains/games/apis/games_hub:surface.h",
        "//domains/games/apis/one_d4:src/main/java/com/muchq/games/one_d4/api/QueryEvent.java",
        "//domains/platform/apis/stats:aggregate.go",
        "//domains/platform/apis/stats:classify.go",
        "//domains/platform/apis/stats:games.go",
        "//domains/platform/apis/stats:queries.go",
        "//domains/platform/apis/stats:route.go",
        "//domains/platform/apis/stats:source.go",
        "//domains/platform/apps/log_shipper:shipper.go",
        "//domains/platform/libs/aura:middleware.cc",
        "//domains/platform/libs/aura:middleware.h",
        "//domains/platform/libs/aura:middleware_test.cc",
        "//domains/platform/libs/caddylog:src/classify.rs",
        "//domains/platform/libs/caddylog:src/route.rs",
        "//domains/platform/libs/event_log:event_log.cc",
        "//domains/platform/libs/futility/otel:http_instrument_descriptions.h",
        "//domains/platform/libs/futility/otel:otel_provider.h",
        "//domains/platform/libs/server_pal:src/lib.rs",
        "//domains/platform/libs/yodel:src/main/java/com/muchq/platform/yodel/HttpServerMetrics.java",
        "//domains/platform/libs/yodel:src/main/java/com/muchq/platform/yodel/OtlpJsonEncoder.java",
        "//domains/platform/libs/yodel:src/main/java/com/muchq/platform/yodel/micronaut/HttpServerMetricsFilter.java",
    ],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
