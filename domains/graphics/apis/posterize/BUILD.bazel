load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel/rules:oci.bzl", "linux_amd64_oci_binary")

rust_binary(
    name = "posterize",
    srcs = [
        "src/images.rs",
        "src/main.rs",
        "src/service.rs",
        "src/types.rs",
    ],
    crate_name = "posterize",
    deps = [
        "//domains/graphics/libs/imagine_rust:imagine_lib",
        "//domains/platform/libs/server_pal",
    ] + all_crate_deps(cargo_only = True),
)

rust_test(
    name = "test_posterize",
    size = "small",
    crate = ":posterize",
    deps = all_crate_deps(normal_dev = True),
)

linux_amd64_oci_binary(bin_name = "posterize")
