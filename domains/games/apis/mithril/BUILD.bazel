load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel/rules:oci.bzl", "linux_amd64_oci_binary")

_GRAPH = "//domains/games/apps/wordchains:generate_graph_json"

rust_binary(
    name = "mithril",
    srcs = [
        "src/main.rs",
    ],
    crate_name = "mithril",
    data = [_GRAPH],
    deps = [
        "//domains/games/libs/wordchains",
        "//domains/platform/libs/server_pal",
    ] + all_crate_deps(cargo_only = True),
)

rust_test(
    name = "test_mithril",
    size = "small",
    crate = ":mithril",
)

rust_test(
    name = "mithril_packaged_test",
    size = "small",
    srcs = ["test/packaged_test.rs"],
    data = [":mithril_tar"],
    edition = "2024",
)

linux_amd64_oci_binary(bin_name = "mithril")
