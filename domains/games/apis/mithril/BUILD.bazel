load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel/rules:oci.bzl", "linux_amd64_oci_binary")

rust_binary(
    name = "mithril",
    srcs = [
        "src/main.rs",
    ],
    crate_name = "mithril",
    data = [
        "//domains/games/apis/mithril:data/j4YL7Lh1H2PAgHy_a625LegUoxk94ZOimjzzx0QKI+Y_.graph",
        "//domains/games/apis/mithril:data/words.txt",
    ],
    deps = [
        "//domains/games/libs/wordchains",
        "//domains/platform/libs/server_pal",
    ] + all_crate_deps(cargo_only = True),
)

rust_test(
    name = "test_mithril",
    size = "small",
    crate = ":mithril",
    deps = all_crate_deps(normal_dev = True),
)

linux_amd64_oci_binary(bin_name = "mithril")
