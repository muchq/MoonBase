    srcs = [
        "src/test/java/com/muchq/games/one_d4/docs/ChessQlReferenceTest.java",
    ],
    deps = [
        ":chessql_reference",
        "//domains/games/libs/chessql:compiler",
        # The Compilation Examples table is checked by compiling its first column.
        "//domains/games/libs/chessql:parser",
        artifact("org.assertj:assertj-core"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
    ],
)

java_library(
    name = "hikaru_corpus",
    testonly = True,
    resource_strip_prefix = "domains/games/apis/one_d4/src/test/resources",
    resources = ["src/test/resources/hikaru_corpus.pgn"],
)

# The same corpus as a plain file, for tests that read it off disk instead
# of the classpath — //domains/games/libs/chess_cpp:corpus_test replays it
# and asserts the same ply count HikaruCorpusParityTest does, which is what
# holds the two tokenizers to each other. One copy of the file, two readers.
filegroup(
    name = "parity_corpora",
    testonly = True,
    srcs = ["src/test/resources/hikaru_corpus.pgn"],
    visibility = ["//domains/games:__subpackages__"],
)

# The frozen parity oracle: the Java pipeline's extraction output over
# hikaru_corpus.pgn, as sorted TSV (#1389). It has no generator — the
# production corpus was indexed under what it records, and
# //domains/games/libs/one_d4_motifs:parity_test measures the C++ detectors
# against it. A deliberate detector change edits it by hand, with the
# reason, in the same commit.
filegroup(
    name = "motif_parity_golden",
    testonly = True,
    srcs = ["src/test/resources/motif_parity_golden.tsv"],
    visibility = ["//domains/games:__subpackages__"],
)

# The DDL itself lives in :migrations_sql (#1419); what schema_contract_test
# still scrapes from Java source is the attempt budget, and nothing else. The
# lease and retention windows reach it as data, from :retention_policy_json
# (#1424), so RetentionPolicy.java does not belong here — listing a source
# nothing opens would re-run the contract test on every edit to it.
filegroup(
    name = "worker_schema_sources",
    testonly = True,
    srcs = [
        "src/main/java/com/muchq/games/one_d4/db/IndexingRequestStore.java",
    ],
    visibility = ["//domains/games:__subpackages__"],
)

# The retention windows, as data rather than as a constant in either language (#1424).
#
# Both readers load this at startup — the C++ worker out of its image's runfiles, Java off its
# classpath — so neither keeps a copy that could drift from it, and a window is changed by editing
# this file. See README.md for what the numbers mean and why they are what they are.
filegroup(
    name = "retention_policy_json",
    srcs = ["retention_policy.json"],
    visibility = ["//domains/games:__subpackages__"],
)

# Deliberately not testonly: RetentionPolicy reads this off the classpath at
# class load, so it ships inside the deploy jar. That is what makes the
# read-or-fail safe — "missing" becomes a build error rather than something a
# deploy can produce.
java_library(
    name = "retention_policy_resource",
    resource_strip_prefix = "domains/games/apis/one_d4",
    resources = ["retention_policy.json"],
    visibility = ["//domains/games:__subpackages__"],
)

# CHESSQL.md as a classpath resource, so mcpserver can serve it as an MCP resource (#1326).
# Deliberately not testonly: this ships inside the mcpserver image. The doc stays a readable file
# in the repo — the resource is the same bytes, not a generated copy — and ChessQlReferenceTest
# pins its rosters against SqlCompiler so the prose cannot drift from what the compiler accepts.
java_library(
    name = "chessql_reference",
    resource_strip_prefix = "domains/games/apis/one_d4/src/main/java/com/muchq/games/one_d4/docs",
    resources = ["src/main/java/com/muchq/games/one_d4/docs/CHESSQL.md"],
    visibility = ["//visibility:public"],
)

