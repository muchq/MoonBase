# The same corpus as a plain file, for tests that read it off disk instead
# of the classpath — //domains/games/libs/chess_cpp:corpus_test replays it
# and asserts the same ply count HikaruCorpusParityTest does, which is what
# holds the two tokenizers to each other. One copy of the file, two readers.
filegroup(
    name = "parity_corpora",
    testonly = True,
    srcs = ["src/test/resources/hikaru_corpus.pgn"],
    visibility = ["//domains/games:__subpackages__"],
)

# The Java pipeline's extraction output, as sorted TSV. The oracle the C++
# port is measured against (#1389 phase 2): MotifGoldenTest asserts the
# checked-in golden still matches what the pipeline produces, and
# //domains/games/libs/one_d4_motifs:parity_test asserts the C++ port
# matches the golden. Neither half is any use without the other.
java_library(
    name = "motif_dump",
    testonly = True,
    srcs = ["src/test/java/com/muchq/games/one_d4/parity/MotifDump.java"],
    visibility = ["//visibility:private"],
    deps = [
        ":engine",
        ":model",
        ":motifs",
    ],
)

java_binary(
    name = "motif_dump_main",
    testonly = True,
    srcs = ["src/test/java/com/muchq/games/one_d4/parity/MotifDumpMain.java"],
    main_class = "com.muchq.games.one_d4.parity.MotifDumpMain",
    deps = [":motif_dump"],
)

