# ChessQL's date/month fields bind UTC day boundaries as java.sql.Timestamp,
# which setTimestamp converts through the JVM's default zone — so the feature
# is only correct if the write and query sides agree on that zone. This target
# pins TZ to UTC+14 so the suite proves the boundaries stay UTC days instead of
# sliding with the JVM. It is its own target because the zone has to be set in
# the environment: H2 caches the default zone on first use, so a mid-JVM
# TimeZone.setDefault would pass vacuously.
java_test_suite(
    name = "played_at_timezone_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/one_d4/db/PlayedAtTimeZoneTest.java",
    ],
    env = {"TZ": "Pacific/Kiritimati"},
    deps = [
        ":db",
        ":dto",
        ":test_db",
        "//domains/games/libs/chessql:compiler",
        "//domains/games/libs/chessql:parser",
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
    ],
)

# The same hazard on indexing_requests, and a sharper one: staleness is measured
# over a one-hour window, so a zone leak does not move the boundary, it inverts
# the predicate — retiring every healthy request or ignoring every strand. Its
# own target for the same reason as above: the zone has to come from the
# environment or H2's cached default makes the suite vacuous.
java_test_suite(
    name = "request_staleness_timezone_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/one_d4/db/RequestStalenessTimeZoneTest.java",
    ],
    env = {"TZ": "Pacific/Kiritimati"},
    deps = [
        ":db",
        ":test_db",
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
    ],
)

# Every other DAO suite runs on H2, but Postgres is the deployment target, and
# some claims are only true — or only falsifiable — there. The aggregate SQL uses
# two constructs the dialects can disagree on: GROUP BY referencing a SELECT-list
# alias, and timestamp binds against a TIMESTAMP-without-zone column. The
# concurrent-write suite covers guarantees about READ COMMITTED behaviour that
# H2's MVStore does not reproduce, so asserting them on H2 would pass either way.
# Real postgres via PG_TEST_DB_URL (which CI's build-and-test job exports);
# skips otherwise.
java_test_suite(
    name = "pg_db_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/one_d4/db/H2IsNotOnThePostgresSuiteClasspathTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresAggregateCompatTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresConcurrentWriteTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresMigrationRunnerTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresPlayerIndexTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresReadTimeoutTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresRetentionIndexTest.java",
        "src/test/java/com/muchq/games/one_d4/db/PostgresSingleLiveReanalysisTest.java",
    ],
    env_inherit = ["PG_TEST_DB_URL"],
    # One shared scratch database: concurrent DB tests drop each other's schemas.
    tags = ["exclusive"],
    runtime_deps = [
        artifact("org.postgresql:postgresql"),
    ],
    deps = [
        ":db",
        ":dto",
        ":model",
        ":pg_test_urls",
        "//domains/games/libs/chessql:compiler",
        "//domains/games/libs/chessql:parser",
        artifact("org.assertj:assertj-core"),
        artifact("org.jdbi:jdbi3-core"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
    ],
)

# URL helper for the Postgres-gated suites. Kept off :test_db on purpose: H2 is a
