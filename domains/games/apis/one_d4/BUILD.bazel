# CHESSQL.md as a classpath resource, so mcpserver can serve it as an MCP resource (#1326).
# Deliberately not testonly: this ships inside the mcpserver image. The doc stays a readable file
# in the repo — the resource is the same bytes, not a generated copy — and ChessQlReferenceTest
# pins its rosters against SqlCompiler so the prose cannot drift from what the compiler accepts.
java_library(
    name = "chessql_reference",
    resource_strip_prefix = "domains/games/apis/one_d4/src/main/java/com/muchq/games/one_d4/docs",
    resources = ["src/main/java/com/muchq/games/one_d4/docs/CHESSQL.md"],
    visibility = ["//visibility:public"],
)

# The first-load request contract shared across languages: FirstPageCacheTest pins the Java
# constants to this file, FirstPageWarmupTest POSTs it verbatim, and 1d4_web's GamesView.test.tsx
# reads the same file from the repo — so either side drifting from the shared wire body fails its
# own CI job instead of silently losing the first-page cache fast path.
java_library(
    name = "first_page_request_fixture",
    testonly = True,
    resource_strip_prefix = "domains/games/apis/one_d4/src/test/resources",
    resources = ["src/test/resources/first_page_request.json"],
)

