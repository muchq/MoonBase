load("@rules_gleam//gleam:defs.bzl", "gleam_format_test", "gleam_package", "gleam_release")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:oci.bzl", "linux_amd64_oci_binary")

exports_files(["manifest.toml"])

# The metric constants otel_contract pins against the other rails.
exports_files(
    [
        "src/mithril_v2/http_metrics.gleam",
        "src/mithril_v2/service.gleam",
    ],
    visibility = ["//domains/platform/libs/otel_contract:__pkg__"],
)

_DATA = [
    "//domains/games/apis/mithril:data/j4YL7Lh1H2PAgHy_a625LegUoxk94ZOimjzzx0QKI+Y_.graph",
    "//domains/games/apis/mithril:data/words.txt",
]

_SRCS = [
    "src/mithril_v2.gleam",
    "src/mithril_v2/http_metrics.gleam",
    "src/mithril_v2/otlp.gleam",
    "src/mithril_v2/runtime.gleam",
    "src/mithril_v2/service.gleam",
    "src/mithril_v2/wordchain.gleam",
    "src/mithril_v2_ffi.erl",
]

_TEST_SRCS = [
    "test/mithril_v2/http_metrics_test.gleam",
    "test/mithril_v2/otlp_test.gleam",
    "test/mithril_v2/service_test.gleam",
    "test/mithril_v2/wordchain_test.gleam",
    "test/mithril_v2_test.gleam",
]

gleam_package(
    name = "mithril_v2",
    srcs = _SRCS,
    data = _DATA,
    gleam_toml = "gleam.toml",
    test_data = ["testdata/v1_ladders.tsv"],
    test_deps = [
        "@gleam_packages//:gleam_crypto",
        "@gleam_packages//:gleeunit",
    ],
    test_srcs = _TEST_SRCS,
    deps = [
        "@gleam_packages//:exception",
        "@gleam_packages//:gleam_erlang",
        "@gleam_packages//:gleam_http",
        "@gleam_packages//:gleam_json",
        "@gleam_packages//:gleam_otp",
        "@gleam_packages//:gleam_stdlib",
        "@gleam_packages//:mist",
    ],
)

gleam_release(
    name = "mithril_v2_bin",
    dep = ":mithril_v2",
    entry_module = "mithril_v2",
)

# The release bundles the OTP it was built with, for the build host, so only
# an image built on linux/amd64 (CI's publish job) runs on the deploy host.
linux_amd64_oci_binary(
    bin_name = "mithril_v2",
    binary = "mithril_v2_bin",
)

sh_test(
    name = "mithril_v2_e2e_test",
    size = "small",
    srcs = ["e2e_test.sh"],
    data = [":mithril_v2_bin"],
)

gleam_format_test(
    name = "mithril_v2_format_test",
    srcs = [src for src in _SRCS if src.endswith(".gleam")] + _TEST_SRCS,
)
