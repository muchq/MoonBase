# Against the generated loopback server, not a hand-rolled fake: which
# errors are NotFound and which are not is a property of the wire shape,
# and reading a 5xx as "no such archive" completes a request having indexed
# nothing.
cc_test(
    name = "chess_com_archive_test",
    size = "small",
    srcs = ["chess_com_archive_test.cc"],
    deps = [
        ":chess_com_archive",
        "//domains/games/libs/chess_com_cpp:chess_com_smithy_server",
        "@com_google_absl//absl/status",
        "@googletest//:gtest_main",
        "@smithy_cpp//runtime:client",
        "@smithy_cpp//runtime:core",
        "@smithy_cpp//runtime:http",
        "@smithy_cpp//runtime:server",
    ],
)

