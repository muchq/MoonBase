# Names and label values shared with the Java worker, read out of
# IndexWorker.java: a name that drifts fails nothing at runtime, it just
# splits one chart into two and leaves one of them empty.
cc_test(
    name = "metrics_test",
    size = "small",
    srcs = ["metrics_test.cc"],
    data = ["//domains/games/apis/one_d4:worker_metric_names"],
    deps = [
        ":metrics",
        "//domains/platform/libs/futility/otel:capturing_metrics_recorder",
        "@com_google_absl//absl/strings",
        "@googletest//:gtest_main",
    ],
)

