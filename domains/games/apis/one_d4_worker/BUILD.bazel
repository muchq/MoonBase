cc_library(
    name = "chess_com_archive",
    srcs = ["chess_com_archive.cc"],
    hdrs = ["chess_com_archive.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":archive",
        "//domains/games/libs/chess_com_cpp:client",
