java_test_suite(
    name = "api_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/mcpserver/api/HealthProbeRouteLabelTest.java",
    ],
    resource_strip_prefix = "domains/platform/resources",
    resources = [
        "//domains/platform/resources:micronaut_config",
    ],
    runtime_deps = [
        "//domains/platform/libs/logging",
