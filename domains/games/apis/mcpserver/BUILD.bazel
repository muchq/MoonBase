load("//bazel/rules:java.bzl", "artifact", "java_binary", "java_library", "java_test_suite")
load("//bazel/rules:oci.bzl", "linux_oci_java")

java_library(
    name = "tools",
    srcs = [
        "src/main/java/com/muchq/games/mcpserver/tools/AggregateGamesTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/AnalyzePositionTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ChessComGamesTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ChessComPlayerTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ChessComPlayersTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ChessComStatsTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/IndexGamesTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/IndexStatusTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/IndexerFacade.java",
        "src/main/java/com/muchq/games/mcpserver/tools/OneD4Client.java",
        "src/main/java/com/muchq/games/mcpserver/tools/QueryGamesTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ServerTimeTool.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ToolDescriptions.java",
        "src/main/java/com/muchq/games/mcpserver/tools/ToolJson.java",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # dto only: the wire types one_d4 already publishes. No :db, :engine or :service — the
        # corpus is reached over HTTP, so this package cannot open a connection to it even by
        # accident (#1332).
        "//domains/games/apis/one_d4:dto",
        "//domains/games/libs/chess_com_client",
        "//domains/platform/libs/http_client:core",
        "//domains/platform/libs/json",
        artifact("com.fasterxml.jackson.core:jackson-core"),
        artifact("com.fasterxml.jackson.core:jackson-databind"),
        # @Tool / @ToolArg. The tool roster and every input schema are derived from
        # these at runtime — there are no hand-written schemas left to drift.
        artifact("io.micronaut.mcp:micronaut-mcp-annotations"),
        artifact("io.micronaut:micronaut-core"),
        artifact("io.micronaut:micronaut-inject"),
        artifact("jakarta.inject:jakarta-inject-api"),
        artifact("org.slf4j:slf4j-api"),
    ],
)

java_library(
    name = "module",
    srcs = [
        "src/main/java/com/muchq/games/mcpserver/McpModule.java",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":tools",
        "//domains/games/libs/chess_com_client",
        "//domains/platform/libs/http_client:core",
        "//domains/platform/libs/http_client:jdk11",
        "//domains/platform/libs/json",
        artifact("com.fasterxml.jackson.core:jackson-databind"),
        artifact("io.micronaut:micronaut-context"),
        artifact("io.micronaut:micronaut-inject"),
        artifact("jakarta.inject:jakarta-inject-api"),
        artifact("org.jspecify:jspecify"),
    ],
)

# The /health liveness endpoint the compose healthcheck probes (#1307). Its
# own library so the route-label test can compile against it without pulling
# the whole binary's srcs into a test target.
java_library(
    name = "api",
    srcs = [
        "src/main/java/com/muchq/games/mcpserver/api/HealthController.java",
    ],
    visibility = ["//visibility:public"],
    deps = [
        artifact("io.micronaut:micronaut-core"),
        artifact("io.micronaut:micronaut-http"),
        artifact("io.micronaut:micronaut-inject"),
    ],
)

# The bearer-token filter, split out of the binary so the auth tests can boot a
# context against it without depending on java_binary srcs.
java_library(
    name = "auth",
    srcs = [
        "src/main/java/com/muchq/games/mcpserver/McpAuthenticationFilter.java",
    ],
    visibility = ["//visibility:public"],
    deps = [
        artifact("io.micronaut:micronaut-context"),
        artifact("io.micronaut:micronaut-core"),
        artifact("io.micronaut:micronaut-http"),
        artifact("io.micronaut:micronaut-inject"),
        artifact("io.projectreactor:reactor-core"),
        artifact("jakarta.inject:jakarta-inject-api"),
        artifact("org.reactivestreams:reactive-streams"),
        artifact("org.slf4j:slf4j-api"),
    ],
)

# JSON-RPC framing, the handshake, tools/list and tools/call all come from
# micronaut-mcp-server-java-sdk; nothing in this binary implements the protocol.
MCP_SERVER_DEPS = [
    artifact("io.micronaut.mcp:micronaut-mcp-server-java-sdk"),
    artifact("io.micronaut:micronaut-jackson-databind"),
]

java_binary(
    name = "mcpserver",
    srcs = [
        "src/main/java/com/muchq/games/mcpserver/App.java",
    ],
    main_class = "com.muchq.games.mcpserver.App",
    visibility = ["//visibility:public"],
    runtime_deps = MCP_SERVER_DEPS + [
        ":api",
        ":auth",
        ":module",
        ":tools",
        "//domains/platform/libs/logging",
        "//domains/platform/libs/yodel:micronaut",
        "//domains/platform/resources:micronaut_config_lib",
    ],
    deps = [
        "//domains/platform/libs/logging",
        artifact("io.micronaut:micronaut-context"),
        artifact("io.micronaut:micronaut-http-server-netty"),
        artifact("io.micronaut:micronaut-runtime"),
        artifact("org.slf4j:slf4j-api"),
    ],
)

linux_oci_java(bin_name = "mcpserver")

java_library(
    name = "mcp_tools_fixture",
    testonly = True,
    resource_strip_prefix = "domains/games/apis/mcpserver/src/test/resources",
    resources = ["src/test/resources/mcp_tools.json"],
)

java_test_suite(
    name = "tools_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/mcpserver/tools/ChessComGamesToolTest.java",
        "src/test/java/com/muchq/games/mcpserver/tools/ChessComPlayerToolTest.java",
        "src/test/java/com/muchq/games/mcpserver/tools/ChessComPlayersToolTest.java",
        "src/test/java/com/muchq/games/mcpserver/tools/ChessComStatsToolTest.java",
        "src/test/java/com/muchq/games/mcpserver/tools/IndexerFacadeHttpTest.java",
        "src/test/java/com/muchq/games/mcpserver/tools/OneD4ClientTest.java",
        "src/test/java/com/muchq/games/mcpserver/tools/ServerTimeToolTest.java",
    ],
    deps = [
        ":module",
        ":tools",
        "//domains/games/apis/one_d4:dto",
        "//domains/games/libs/chess_com_client",
        "//domains/platform/libs/http_client:core",
        "//domains/platform/libs/http_client:jdk11",
        "//domains/platform/libs/json",
        artifact("com.fasterxml.jackson.core:jackson-databind"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
    ],
)

java_test_suite(
    name = "module_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/mcpserver/McpModuleTest.java",
    ],
    runtime_deps = [
        "//domains/platform/libs/logging",
    ],
    deps = [
        ":module",
        ":tools",
        artifact("io.micronaut:micronaut-context"),
        artifact("io.micronaut:micronaut-inject"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
    ],
)

# Boots the real server and speaks MCP to it over HTTP: the handshake, the
# advertised roster, a tool call, and the auth gate in both of its states.
# These are the tests that would have caught the notifications/initialized
# violation the hand-rolled transport shipped with (#1325).
java_test_suite(
    name = "protocol_tests",
    # medium, not small: McpAuthenticationTest boots eight embedded servers, each running
    # H2 migrations and the indexer wiring, which sits too close to small's 60s ceiling on
    # a loaded CI machine — the same reason one_d4's http_integration_tests is medium.
    size = "medium",
    srcs = [
        "src/test/java/com/muchq/games/mcpserver/McpAuthenticationTest.java",
        "src/test/java/com/muchq/games/mcpserver/McpProtocolTest.java",
        "src/test/java/com/muchq/games/mcpserver/McpToolRosterContractTest.java",
    ],
    runtime_deps = MCP_SERVER_DEPS + [
        ":api",
        ":auth",
        ":module",
        ":tools",
        "//domains/platform/libs/logging",
        "//domains/platform/libs/yodel:micronaut",
        "//domains/platform/resources:micronaut_config_lib",
    ],
    deps = [
        ":mcp_tools_fixture",
        "//domains/platform/libs/json",
        artifact("com.fasterxml.jackson.core:jackson-databind"),
        artifact("io.micronaut:micronaut-context"),
        artifact("io.micronaut:micronaut-http-server-netty"),
        artifact("io.micronaut:micronaut-inject"),
        artifact("io.micronaut:micronaut-runtime"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
    ],
)

java_test_suite(
    name = "api_tests",
    size = "small",
    srcs = [
        "src/test/java/com/muchq/games/mcpserver/api/HealthProbeRouteLabelTest.java",
    ],
    # MCP_SERVER_DEPS carries micronaut-jackson-databind, which the embedded
    # server's error-response path needs for its JSON codec beans
    # (JsonErrorResponseBodyProvider et al) — same as the binary.
    runtime_deps = MCP_SERVER_DEPS + [
        ":module",
        ":tools",
        "//domains/platform/libs/logging",
        "//domains/platform/resources:micronaut_config_lib",
    ],
    deps = [
        ":api",
        "//domains/platform/libs/yodel",
        "//domains/platform/libs/yodel:micronaut",
        artifact("io.micronaut:micronaut-context"),
        artifact("io.micronaut:micronaut-http-server-netty"),
        artifact("io.micronaut:micronaut-inject"),
        artifact("io.micronaut:micronaut-runtime"),
        artifact("org.junit.jupiter:junit-jupiter-api"),
        artifact("org.assertj:assertj-core"),
    ],
)
