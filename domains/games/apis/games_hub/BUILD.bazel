# The step-2 restart-survival e2e (#1194): same client flows, durable
# hub, RestartHub between them. Real postgres via GAMES_HUB_TEST_DB_URL;
# skips otherwise.
cc_test(
    name = "pg_hub_e2e_test",
    # Small on purpose (#1241, #1276): normal runtime is ~2s; the tight
    # ceiling turns a recurrence into a loud red. Two hang shapes share
    # the signature — a lost LISTEN/NOTIFY wakeup (fixed in pg::Listener)
    # and a TearDown End() deadlock on unread wake frames (smithy-cpp#173
    # send-before-receive; QuiesceCrossTable still drains for deterministic
    # teardown). Do not raise the ceiling.
    size = "small",
    srcs = [
        "pg_hub_e2e_test.cc",
        "stream_test_fixture.h",
    ],
    env_inherit = ["GAMES_HUB_TEST_DB_URL"],
    # One shared scratch database: concurrent DB tests truncate each
    # other mid-flight.
    tags = ["exclusive"],
    deps = [
        ":games_hub_smithy_client",
        ":games_hub_smithy_server",
        ":hub_handler",
        ":hub_store",
        ":id_generator",
        ":pg_chat_store",
        ":pg_hub_store",
        ":pg_ticket_vault",
        ":thoughts_hub",
        ":ticket_vault",
        "//domains/games/libs/cards:dealer",
        "//domains/platform/libs/futility/otel:capturing_metrics_recorder",
        "//domains/platform/libs/futility/otel:metrics",
        "//domains/platform/libs/pg",
        "//domains/platform/libs/pg:listener",
        "@googletest//:gtest_main",
        "@smithy_cpp//runtime:client",
        "@smithy_cpp//runtime:core",
        "@smithy_cpp//runtime:http",
        "@smithy_cpp//runtime:http_beast",
    ],
)

# Beyoncé Rule wire-contract tests (consumer tier): the raw HTTP bytes and
# eventstream frames the golf web client depends on, pinned as golden
# fixtures driven through the generated server WITHOUT the generated
# client — a regeneration that renames what the web client reads (the
# session bodies, the room-layer events and their ordering, the golf
# command/update envelopes and GameView, the terminal exception frames)
# fails here even though the typed e2e suites (which regenerate with it)
# still pass. Non-Beast deps only, so it runs with no sandbox setup at all
# (behind a blocking proxy, Beast needs scripts/make-git-overrides.sh first).
cc_test(
    name = "golf_wire_test",
    size = "small",
    srcs = [
        "golf_wire_test.cc",
        "wire_test_fixture.h",
    ],
    deps = [
        ":games_hub_smithy_server",
        ":hub_handler",
        ":id_generator",
        ":rate_limiter",
        ":ticket_vault",
        "//domains/games/libs/cards:dealer",
        "//domains/platform/libs/futility/otel:capturing_metrics_recorder",
        "//domains/platform/libs/futility/otel:metrics",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
        "@smithy_cpp//runtime:core",
        "@smithy_cpp//runtime:eventstream",
        "@smithy_cpp//runtime:http",
    ],
)

cc_test(
    name = "hub_e2e_test",
    size = "small",
    srcs = [
        "hub_e2e_test.cc",
        "stream_test_fixture.h",
    ],
    # StreamSeriesMatchTheModelUnions reads the model to pin the declared
    # stream_commands/stream_events rosters against its union cases.
    data = ["model/golf.smithy"],
    deps = [
        ":games_hub_smithy_client",
        ":games_hub_smithy_server",
        ":hub_handler",
        ":hub_store",
        ":id_generator",
        ":thoughts_hub",
        ":ticket_vault",
        "//domains/games/libs/cards:dealer",
        "//domains/platform/libs/futility/otel:capturing_metrics_recorder",
        "//domains/platform/libs/futility/otel:metrics",
        "@googletest//:gtest_main",
        "@smithy_cpp//runtime:client",
        "@smithy_cpp//runtime:core",
        "@smithy_cpp//runtime:http",
        # The generated streaming client names BeastWebSocketClient::Dialer()
        # unconditionally, even under an injected dialer (documented ADR-0016
        # cost) — the symbol must link from somewhere.
        "@smithy_cpp//runtime:http_beast",
    ],
)

