    name = "one_d4_v2",
    srcs = ["main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":one_d4_v2_smithy_server",
        ":smithy_handler",
        "//domains/platform/libs/aura",
        "//domains/platform/libs/futility/env",
        "//domains/platform/libs/futility/otel:http_metrics",
