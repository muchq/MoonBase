load("@rules_apple//apple:ios.bzl", "ios_application", "ios_ui_test", "ios_unit_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift.bzl", "swift_library")

# The app's version, read by the hub's client_tag_test: a release must be
# declared there to be counted under its own version.
exports_files(
    ["Info.plist"],
    visibility = ["//domains/games/apis/games_hub:__pkg__"],
)

# Reuse the word graph generated by the wordchains CLI build.
# This is the same JSON the Rust lib produces via `wordchains generate-graph`.
alias(
    name = "word_graph_json",
    actual = "//domains/games/apps/wordchains:generate_graph_json",
)

swift_library(
    name = "WordChainsLib",
    srcs = glob(["Sources/**/*.swift"]),
    data = [
        ":word_graph_json",
    ],
    module_name = "WordChains",
    target_compatible_with = ["@platforms//os:ios"],
)

# App Store signing: build with --define=ios_release_signing=true and place
# the distribution provisioning profile at WordChains.mobileprovision in this
# package (CI decodes it from the IOS_PROVISIONING_PROFILE secret; the file is
# gitignored). Default builds (simulator CI tests) stay unsigned.
config_setting(
    name = "release_signing",
    define_values = {"ios_release_signing": "true"},
)

filegroup(
    name = "provisioning_profile",
    srcs = glob(
        ["*.mobileprovision"],
        allow_empty = True,
    ),
)

# The Apple bundling rules transition to an iOS target platform before
# target_compatible_with is evaluated, so os:ios can't keep Linux CI off
# them — Linux analysis fails resolving an Apple C++ toolchain instead of
# skipping. Tag them manual; the test-ios job and the release workflow
# request them by explicit label, which builds manual targets.
ios_application(
    name = "WordChains",
    bundle_id = "com.muchq.wordchains",
    # iPhone only for v1; app_store_test holds it.
    families = [
        "iphone",
    ],
    infoplists = [":Info.plist"],
    minimum_os_version = "17.0",
    provisioning_profile = select({
        ":release_signing": ":provisioning_profile",
        "//conditions:default": None,
    }),
    # The puzzle words travel with SCOWL's notice, as its license asks.
    resources = [
        ":word_graph_json",
        "//domains/games/libs/wordchain_race:SCOWL_COPYRIGHT",
        "//domains/games/libs/wordchain_race:common_words.txt",
    ] + glob(["Sources/Resources/**"]),
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:ios"],
    visibility = ["//visibility:public"],
    deps = [":WordChainsLib"],
)

swift_library(
    name = "WordChainsTestLib",
    testonly = True,
    srcs = glob(["Tests/**/*.swift"]),
    target_compatible_with = ["@platforms//os:ios"],
    deps = [":WordChainsLib"],
)

# Unlike ios_application, the test rule stays in the host configuration
# (only its deps transition to iOS), so it must be compatible with the
# macOS host that runs the simulator.
# Booting a freshly created simulator on a cold CI runner alone can exceed
# the default 300s.
ios_unit_test(
    name = "WordChainsTests",
    timeout = "long",
    minimum_os_version = "17.0",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":WordChainsTestLib"],
)

swift_library(
    name = "WordChainsUITestLib",
    testonly = True,
    srcs = glob(["UITests/**/*.swift"]),
    target_compatible_with = ["@platforms//os:ios"],
)

ios_ui_test(
    name = "WordChainsUITests",
    timeout = "long",
    env = {"CREATE_XCRESULT_BUNDLE": "1"},
    minimum_os_version = "17.0",
    resources = [":word_graph_json"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    test_host = ":WordChains",
    deps = [":WordChainsUITestLib"],
)

# Runs on Linux: the plist and icon rules App Store Connect enforces, so they
# fail a PR rather than the first signed upload.
sh_test(
    name = "app_store_test",
    size = "small",
    srcs = ["app_store_test.sh"],
    # The sources too: what the code calls decides what the manifest declares.
    data = [
        "BUILD.bazel",
        "Info.plist",
    ] + glob(["Sources/**"]),
)
