load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Spades (#1658): partnership trick-taking, a hand and a table of hands.

cc_library(
    name = "hand",
    srcs = ["hand.cc"],
    hdrs = ["hand.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//domains/games/libs/cards",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "hand_test",
    size = "small",
    srcs = ["hand_test.cc"],
    deps = [
        ":hand",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "scoring",
    srcs = ["scoring.cc"],
    hdrs = ["scoring.h"],
    visibility = ["//visibility:public"],
    deps = [":hand"],
)

cc_test(
    name = "scoring_test",
    size = "small",
    srcs = ["scoring_test.cc"],
    deps = [
        ":scoring",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "table",
    srcs = ["table.cc"],
    hdrs = ["table.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":hand",
        ":scoring",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
    ],
)

cc_test(
    name = "table_test",
    size = "small",
    srcs = ["table_test.cc"],
    deps = [
        ":table",
        "@googletest//:gtest_main",
    ],
)

# Versioned serde of the table, the games table's column for a spades row.
cc_library(
    name = "table_serde",
    srcs = ["table_serde.cc"],
    hdrs = ["table_serde.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":hand",
        ":table",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "table_serde_test",
    size = "small",
    srcs = ["table_serde_test.cc"],
    deps = [
        ":table",
        ":table_serde",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
