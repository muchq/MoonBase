load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The rummy rules engine (#245): immutable GameState value type for the
# games hub.

cc_library(
    name = "meld",
    srcs = ["meld.cc"],
    hdrs = ["meld.h"],
    visibility = ["//visibility:public"],
    deps = ["//domains/games/libs/cards"],
)

cc_library(
    name = "game_state",
    srcs = ["game_state.cc"],
    hdrs = ["game_state.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":meld",
        "//domains/games/libs/cards",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
    ],
)

cc_test(
    name = "meld_test",
    size = "small",
    srcs = ["meld_test.cc"],
    deps = [
        ":meld",
        "//domains/games/libs/cards",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "game_state_test",
    size = "small",
    srcs = ["game_state_test.cc"],
    deps = [
        ":game_state",
        "//domains/games/libs/cards",
        "//domains/games/libs/cards:dealer",
        "@com_google_absl//absl/status",
        "@googletest//:gtest_main",
    ],
)

# Versioned serde of the engine's full truth, the games table's column
# for a rummy row. Server-side only — redaction stays in the hub.
cc_library(
    name = "game_state_serde",
    srcs = ["game_state_serde.cc"],
    hdrs = ["game_state_serde.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":game_state",
        "//domains/games/libs/cards",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "game_state_serde_test",
    size = "small",
    srcs = ["game_state_serde_test.cc"],
    deps = [
        ":game_state",
        ":game_state_serde",
        "//domains/games/libs/cards",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
