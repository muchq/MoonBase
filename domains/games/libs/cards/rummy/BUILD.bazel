load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The rummy rules engine (#245): immutable GameState value type for the
# games hub.

cc_library(
    name = "meld",
    srcs = ["meld.cc"],
    hdrs = ["meld.h"],
    visibility = ["//visibility:public"],
    deps = ["//domains/games/libs/cards"],
)

cc_library(
    name = "arrange",
    srcs = ["arrange.cc"],
    hdrs = ["arrange.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":meld",
        "//domains/games/libs/cards",
    ],
)

# The corpus is shared with the web client's search (muchq.github.io
# src/apps/rummy), which replays a copy; testdata/make_arrange_corpus.py
# makes it from a brute force of its own.
cc_test(
    name = "arrange_test",
    size = "small",
    srcs = ["arrange_test.cc"],
    data = ["testdata/arrange_corpus.json"],
    deps = [
        ":arrange",
        ":meld",
        "//domains/games/libs/cards",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "gin",
    srcs = ["gin.cc"],
    hdrs = ["gin.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":arrange",
        ":game_state",
        "//domains/games/libs/cards",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
    ],
)

cc_test(
    name = "gin_test",
    size = "small",
    srcs = ["gin_test.cc"],
    deps = [
        ":gin",
        "//domains/games/libs/cards",
        "//domains/games/libs/cards:dealer",
