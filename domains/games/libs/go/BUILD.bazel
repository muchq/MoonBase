load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Go at a games-hub table: the rules (captures, no suicide, simple ko,
# area scoring with komi), a Fischer clock, game after game at one table,
# and its stored form.

cc_library(
    name = "game_state",
    srcs = ["game_state.cc"],
    hdrs = ["game_state.h"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "game_state_test",
    size = "small",
    srcs = ["game_state_test.cc"],
    deps = [
        ":game_state",
        "@com_google_absl//absl/status",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "table",
    srcs = ["table.cc"],
    hdrs = ["table.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":game_state",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "table_test",
    size = "small",
    srcs = ["table_test.cc"],
    deps = [
        ":game_state",
        ":table",
        "@com_google_absl//absl/status",
        "@googletest//:gtest_main",
    ],
)

# The games table's column for a go row. Server-side only.
cc_library(
    name = "table_serde",
    srcs = ["table_serde.cc"],
    hdrs = ["table_serde.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":game_state",
        ":table",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "table_serde_test",
    size = "small",
    srcs = ["table_serde_test.cc"],
    deps = [
        ":game_state",
        ":table",
        ":table_serde",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
