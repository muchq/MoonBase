# Runs the port over the same 500 games the Java pipeline's golden covers.
# medium on measurement: 0.3s normally, 11.8s under tsan — the sanitize jobs
# build -c dbg, which also re-arms the vendored header's asserts.
cc_test(
    name = "parity_test",
    size = "medium",
    srcs = ["parity_test.cc"],
    data = [
        "testdata/cross_pins.tsv",
        "//domains/games/apis/one_d4:motif_parity_golden",
        "//domains/games/apis/one_d4:parity_corpora",
    ],
    deps = [
        ":extract",
        ":motif",
        ":occurrence",
        "//domains/games/libs/chess_cpp:pgn",
        "//domains/games/libs/chess_cpp:side",
        "@com_google_absl//absl/strings",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "tactics_corpus_test",
