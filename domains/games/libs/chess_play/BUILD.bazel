load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Chess at a games-hub table: the rules engine the hub plays (full rules,
# a Fischer clock, a variant's opening) and its stored form. Its headers
# name no chess-library type; the library stays behind the .cc files.

cc_library(
    name = "game_state",
    srcs = ["game_state.cc"],
    hdrs = ["game_state.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel/3p/chess_library",
        "@com_google_absl//absl/random",
        "@com_google_absl//absl/random:bit_gen_ref",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "game_state_test",
    size = "small",
    srcs = ["game_state_test.cc"],
    deps = [
        ":game_state",
        "@com_google_absl//absl/random",
        "@com_google_absl//absl/status",
        "@googletest//:gtest_main",
    ],
)

# The games table's column for a chess row. Server-side only.
cc_library(
    name = "game_state_serde",
    srcs = ["game_state_serde.cc"],
    hdrs = ["game_state_serde.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":game_state",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "game_state_serde_test",
    size = "small",
    srcs = ["game_state_serde_test.cc"],
    deps = [
        ":game_state",
        ":game_state_serde",
        "@com_google_absl//absl/status",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
