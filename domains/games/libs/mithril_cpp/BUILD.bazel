load("@opal_cpp//bazel:defs.bzl", "smithy_cpp_client_library")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# mithril's wordchain, for C++ consumers: games_hub's /wordchain command.
smithy_cpp_client_library(
    name = "mithril_smithy_client",
    srcs = [
        "model/bindings/simplerestjson.smithy",
        "model/mithril.smithy",
    ],
    namespace = "moonbase::mithril",
    service = "moonbase.mithril#Mithril",
)

cc_library(
    name = "client",
    srcs = ["client.cc"],
    hdrs = ["client.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":mithril_smithy_client",
        "@opal_cpp//runtime:client",
        "@opal_cpp//runtime:core",
    ],
)

cc_library(
    name = "production_client",
    srcs = ["production_client.cc"],
    hdrs = ["production_client.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":client",
        "@opal_cpp//runtime:core",
        "@opal_cpp//runtime:http_beast",
    ],
)

# The consumer-tier pin: the request the hub sends and the answers mithril
# gives, as the same bytes the Rust tests pin.
cc_test(
    name = "wordchain_wire_test",
    size = "small",
    srcs = ["wordchain_wire_test.cc"],
    deps = [
        ":client",
        ":mithril_smithy_client",
        "@googletest//:gtest_main",
        "@opal_cpp//runtime:client",
        "@opal_cpp//runtime:core",
        "@opal_cpp//runtime:http",
    ],
)

cc_test(
    name = "production_client_test",
    size = "small",
    srcs = ["production_client_test.cc"],
    deps = [
        ":production_client",
        "@googletest//:gtest_main",
    ],
)
