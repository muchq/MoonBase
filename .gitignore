# Ignore .claude's contents, but track the pieces the repo actually shares:
# the session-start hook and the settings that register it. Ignoring the
# directory itself would stop git descending into it, so the negations below
# would never match. settings.local.json stays ignored — that is where
# machine- and session-specific grants belong.
.claude/*
!.claude/hooks/
!.claude/settings.json
.kiro
vcpkg_installed
conan
rust-project.json
go/r3dr/deploy/deploy.sh
models
checkpoints

.env
local_docker
local_docs

node_modules
web/build_pal/dist

# Machine-specific bazel flags (try-import'd by .bazelrc); scripts/make-git-overrides.sh
.bazelrc.user
.build
.swiftpm
*.mobileprovision
