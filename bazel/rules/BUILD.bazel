# Trust roots for outbound TLS, lifted out of a base image we already pin.
#
# The ubuntu base ships libssl and nothing under /etc/ssl, so BoringSSL's
# set_default_verify_paths() finds no roots and every handshake fails
# CERTIFICATE_VERIFY_FAILED. That is not a knob anyone can set at deploy
# time: smithy's TlsOptions falls back to the system paths, and there are
# none.
#
# Taken from the pinned distroless_base rather than downloaded, so the
# roots come from a digest already in oci.MODULE.bazel — no second trust
# decision and no separate refresh story. Refreshing them is bumping that
# digest, which is a thing somebody already has to do.
#
# The extractor fails the build if the file moves or the image stops
# carrying it, rather than quietly producing an image with no roots.
genrule(
    name = "ca_certificates_crt",
    srcs = ["@distroless_base_linux_amd64"],
    outs = ["distroless-ca-certificates.crt"],
    cmd = "bash $(execpath extract_ca_certificates.sh) $(execpath @distroless_base_linux_amd64//:distroless_base_linux_amd64) $@",
    tools = ["extract_ca_certificates.sh"],
    visibility = ["//visibility:private"],
)

# The distroless roots, less the ones we distrust, as the PEM bundle every
# image gets and a JKS truststore for the java images. Neither the pinned
# distroless nor the pinned zulu base has dropped the roots in OpenJDK's
# eMudhra advisory (https://openjdk.org/emudhra), so we drop them here.
# Bumping a base image cannot bring them back.
#
# The java images use this store and not the JDK's own cacerts, so all of
# our runtimes trust the same set of roots. Overwriting the JDK's cacerts in
# a layer is not an option: JAVA_HOME is a symlink to a directory named per
# architecture, and one layer has to serve both architectures.
genrule(
    name = "trusted_roots",
    srcs = [":ca_certificates_crt"],
    outs = [
        "ca-certificates.crt",
        "cacerts",
    ],
    cmd = "$(execpath :distrust_roots) $< $(OUTS)",
    tools = [":distrust_roots"],
    visibility = ["//visibility:private"],
)

java_binary(
    name = "distrust_roots",
    srcs = ["DistrustRoots.java"],
    main_class = "DistrustRoots",
    visibility = ["//visibility:private"],
)

java_test(
    name = "distrusted_roots_test",
    size = "small",
    srcs = ["DistrustedRootsTest.java"],
    args = [
        "$(rootpath :ca_certificates_pem)",
        "$(rootpath :cacerts)",
    ],
    data = [
        ":ca_certificates_pem",
        ":cacerts",
    ],
