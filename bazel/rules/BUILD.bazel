exports_files([
    "java_image_test.yaml",
    "oci_image_test.yaml",
])

# Trust roots for outbound TLS, lifted out of a base image we already pin.
#
# The ubuntu base ships libssl and nothing under /etc/ssl, so BoringSSL's
# set_default_verify_paths() finds no roots and every handshake fails
# CERTIFICATE_VERIFY_FAILED. That is not a knob anyone can set at deploy
# time: smithy's TlsOptions falls back to the system paths, and there are
# none.
#
# Taken from the pinned distroless_base rather than downloaded, so the
# roots come from a digest already in oci.MODULE.bazel — no second trust
# decision and no separate refresh story. Refreshing them is bumping that
# digest, which is a thing somebody already has to do.
#
# The genrule fails the build if the file moves or the image stops
# carrying it, rather than quietly producing an image with no roots.
genrule(
    name = "ca_certificates_crt",
    srcs = ["@distroless_base_linux_amd64"],
    outs = ["ca-certificates.crt"],
    cmd = """
set -eu
for blob in $(location @distroless_base_linux_amd64//:distroless_base_linux_amd64)/blobs/sha256/*; do
  if tar xOf "$$blob" ./etc/ssl/certs/ca-certificates.crt > $@.part 2>/dev/null; then
    if [ -s $@.part ]; then
      mv $@.part $@
      exit 0
    fi
  fi
done
echo "no ./etc/ssl/certs/ca-certificates.crt in the pinned distroless layers" >&2
exit 1
""",
    visibility = ["//visibility:private"],
)

# Two names for the same bytes, because two runtimes look in two places.
#
# BoringSSL's set_default_verify_paths() registers exactly two lookups: a
# file at X509_get_default_cert_file(), which is OPENSSLDIR "/cert.pem"
# and OPENSSLDIR is /etc/ssl, and a hash dir at /etc/ssl/certs that it
# only ever reads as <8-hex-hash>.<n>. A bundle at
# /etc/ssl/certs/ca-certificates.crt matches neither lookup, so shipping
# that path alone leaves every C++ handshake failing CERTIFICATE_VERIFY_FAILED
# with the bundle sitting right there in the image, plainly visible and
# never opened.
#
# Go's crypto/x509 does read the Debian bundle path, and this same rule
# builds the Go images, so both names ship rather than one replacing the
# other.
genrule(
    name = "ca_certificates_pem",
    srcs = [":ca_certificates_crt"],
    outs = ["cert.pem"],
    cmd = "cp $< $@",
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "ca_certificates_bundle",
    srcs = [":ca_certificates_crt"],
    modes = {"ca-certificates.crt": "0644"},
    package_dir = "/etc/ssl/certs",
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "ca_certificates_default_file",
    srcs = [":ca_certificates_pem"],
    modes = {"cert.pem": "0644"},
    package_dir = "/etc/ssl",
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "ca_certificates_layer",
    visibility = ["//visibility:public"],
    deps = [
        ":ca_certificates_bundle",
        ":ca_certificates_default_file",
    ],
)

sh_test(
    name = "ca_certificates_layer_test",
    size = "small",
    srcs = ["ca_certificates_layer_test.sh"],
    data = [":ca_certificates_layer"],
)

