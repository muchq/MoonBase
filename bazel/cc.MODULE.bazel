bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name = "com_google_absl")
bazel_dep(name = "check", version = "0.15.2.bcr.2")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "libpng", version = "1.6.58.bcr.1")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "opentelemetry-cpp", version = "1.29.0")
bazel_dep(name = "curl", version = "8.22.0")

# libpq for the games_hub persistence plan (#1194): the BCR's postgres
# module builds the client library from source (rules_cc_autoconf, no
# foreign_cc); consumers depend on @postgres//:libpq via the owned
# wrapper in //domains/platform/libs/pg. Version tracks the deployed
# postgres:18 image in deploy/consolidated/compose.yaml.
bazel_dep(name = "postgres", version = "18.4")

# Native cc rules; the X11, Wayland and ALSA headers come from the BCR too, and
# SDL loads those libraries at runtime by soname.
bazel_dep(name = "sdl3", version = "3.4.18")

# sdl3 forwards its runtime-loaded libraries' headers through a rule that drops
# the include paths --features=external_include_paths (.bazelrc) moves aside,
# so the X11 and Wayland headers go missing. The patch forwards them.
single_version_override(
    module_name = "sdl3",
    patch_strip = 1,
    patches = ["//bazel/3p:sdl3_cc_headers_only_external_includes.patch"],
)

raylib_ext = use_extension("//bazel/extensions:raylib.bzl", "raylib")
use_repo(raylib_ext, "raylib")

bazel_dep(name = "glfw", version = "3.4.0.bcr.4")

# glfw links xkbcommon, whose parser rules_bison generates with a helper that
# calls getenv without <cstdlib>; LLVM 23's libc++ no longer brings it in.
single_version_override(
    module_name = "rules_bison",
    patch_strip = 1,
    patches = ["//bazel/3p:rules_bison_runfiles_cstdlib.patch"],
)

# Floor: earlier releases miss <iterator>.
bazel_dep(name = "rules_cc_autoconf", version = "0.29.0")
