bazel_dep(name = "opal_cpp", version = "0.0.0")

# opal_cpp is not published to the Bazel Central Registry yet, so the module
# version above is a placeholder and the source comes from the pinned archive
# below. The integrity hash pins the contents, so a re-pointed URL fails
# loudly rather than silently changing the build.
# Evaluation: https://github.com/muchq/MoonBase/issues/1168
#
# Generated clients stream a @streaming blob response payload, and the retry
# loop honors Retry-After — both for the lichess archive (#1527). Responses
# now cap at ClientConfig::max_response_bytes, 64 MiB; a 500-game chess.com
# month is about 2 MB.
#
# A modeled @httpHeader("Accept") also reaches the wire now (opal-cpp #220,
# found here): an operation with a response @httpPayload used to overwrite it
# with the payload's content type, so the member was set and then discarded on
# every call. It is a default rather than an override, which is what lets the
# lichess client state PGN in its model instead of from an interceptor.
archive_override(
    module_name = "opal_cpp",
    integrity = "sha256-+zRdcJg2ivmRdDSE7FP9JlA0Z+psI8Kd6JtJ4hDRp74=",
    strip_prefix = "opal-cpp-b829d71a82f178db0770d75d46e66816dd596e7c",
    urls = [
        "https://github.com/muchq/opal-cpp/archive/b829d71a82f178db0770d75d46e66816dd596e7c.tar.gz",
    ],
)
