bazel_dep(name = "opal_cpp", version = "0.0.0")

# opal_cpp is not published to the Bazel Central Registry yet, so the module
# version above is a placeholder and the source comes from the pinned archive
# below. The integrity hash pins the contents, so a re-pointed URL fails
# loudly rather than silently changing the build.
# Evaluation: https://github.com/muchq/MoonBase/issues/1168
#
# Generated clients stream a @streaming blob response payload, and the retry
# loop honors Retry-After — both for the lichess archive (#1527). Responses
# cap at ClientConfig::max_response_bytes, 64 MiB; a 500-game chess.com month
# is about 2 MB.
#
# A modeled @httpHeader("Accept") reaches the wire as a default that a response
# @httpPayload's content type does not override (opal-cpp #220), so the
# lichess client states PGN in its model instead of from an interceptor.
#
# Inbound stream events are validated against the model's constraints
# (opal-cpp #228): a violation reaches the handler as Error::Validation, and
# the session stays open; games_hub refuses it in band. SessionRegistry
# sends take a delivery class (#227): games_hub coalesces world moves.
archive_override(
    module_name = "opal_cpp",
    integrity = "sha256-eY0B+bcEpX8y/bM24xQ96dWR5qcebcvQgxnkz2d/3Yk=",
    strip_prefix = "opal-cpp-57d6842a4bd2f24ba54a2091703306c596aa8dd3",
    urls = [
        "https://github.com/muchq/opal-cpp/archive/57d6842a4bd2f24ba54a2091703306c596aa8dd3.tar.gz",
    ],
)
