bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "contrib_rules_jvm", version = "0.33.0")

single_version_override(
    module_name = "rules_android",
    version = "0.7.1",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

JETTY_VERSION = "11.0.26"

LOGBACK_VERSION = "1.5.37"

NULLAWAY_VERSION = "0.13.7"

ERROR_PRONE_VERSION = "2.50.0"

maven.install(
    artifacts = [
        "ch.qos.logback:logback-classic:%s" % LOGBACK_VERSION,
        "ch.qos.logback:logback-core:%s" % LOGBACK_VERSION,
        # Versioned explicitly: micronaut-core-bom is listed first and pins annotations
        # to 2.21, while Micronaut 5 does not manage Jackson 2 core/databind at all, so those
        # fall through to jackson-bom below and land on 2.22.0. databind introspects
        # annotation classes, so leaving the family split across minors is a trap that
        # only bites on some future bump. No patch component: jackson-annotations
        # dropped it in 2.20, which is why jackson-bom:2.22.0 pins it to plain "2.22".
        "com.fasterxml.jackson.core:jackson-annotations:2.22",
        "com.fasterxml.jackson.core:jackson-core",
        "com.fasterxml.jackson.core:jackson-databind",
        "com.github.ben-manes.caffeine:caffeine:3.2.2",
        "com.google.errorprone:error_prone_core:%s" % ERROR_PRONE_VERSION,
        "com.uber.nullaway:nullaway:%s" % NULLAWAY_VERSION,
        "com.zaxxer:HikariCP:7.1.0",
        "dev.failsafe:failsafe:3.3.2",
        "io.github.tors42:chariot:0.2.10",
        "com.h2database:h2:2.4.240",
        "org.jdbi:jdbi3-core:3.54.0",
        "org.postgresql:postgresql:42.7.13",
        "com.fasterxml.jackson.datatype:jackson-datatype-guava",
        "com.fasterxml.jackson.datatype:jackson-datatype-jdk8",
        "com.fasterxml.jackson.datatype:jackson-datatype-jsr310",
        "com.fasterxml.jackson.module:jackson-module-scala_2.13",
        "com.google.guava:guava:33.6.0-jre",
        "io.micronaut:micronaut-inject",
        "io.micronaut:micronaut-inject-java",
        "io.micronaut.validation:micronaut-validation",
        "io.micronaut.validation:micronaut-validation-processor",
        "io.micronaut:micronaut-http-client",
        "io.micronaut:micronaut-http-server-netty",
        "io.micronaut:micronaut-jackson-databind",
        "io.micronaut:micronaut-runtime",
        "io.micronaut.jaxrs:micronaut-jaxrs-processor",
        "io.micronaut.jaxrs:micronaut-jaxrs-server",
        "io.micronaut.mcp:micronaut-mcp-annotations",
        "io.micronaut.mcp:micronaut-mcp-server-java-sdk",
        "io.netty:netty-common",
        "io.netty:netty-codec",
        "io.netty:netty-handler",
        "io.netty:netty-transport",
        "io.sentry:sentry-logback:8.47.0",
        "jakarta.annotation:jakarta.annotation-api:3.0.0",
        "org.junit.jupiter:junit-jupiter-api",
        "org.junit.jupiter:junit-jupiter-engine",
        "org.junit.jupiter:junit-jupiter-params",
        "org.junit.platform:junit-platform-launcher",
        "org.junit.platform:junit-platform-reporting",
        "org.assertj:assertj-core:3.27.7",
        "org.eclipse.jetty:jetty-server:%s" % JETTY_VERSION,
        "org.eclipse.jetty.websocket:websocket-jetty-server:%s" % JETTY_VERSION,
        "org.jspecify:jspecify:1.0.0",
        "org.slf4j:slf4j-api:2.0.18",
        # Micronaut's YamlPropertySourceLoader is compiled against classic snakeyaml
        # (org.yaml.snakeyaml.Yaml) and disables itself when that class is absent —
        # silently, so application.yml is simply never read. Nothing in this repo had
        # it before micronaut-mcp pulled it in transitively, and the Micronaut 5 /
        # Jackson 3 upgrade dropped it again (Jackson 3 uses snakeyaml-engine, a
        # different package). Declared directly so YAML config depends on nothing but
        # itself: without it the file is inert and every property silently defaults.
        "org.yaml:snakeyaml:2.4",
    ],
    boms = [
        "io.netty:netty-bom:4.2.16.Final",
        "io.micronaut:micronaut-core-bom:5.1.10",
        "io.micronaut.jaxrs:micronaut-jaxrs-bom:5.1.0",
        "io.micronaut.validation:micronaut-validation-bom:5.1.0",
        "io.micronaut.mcp:micronaut-mcp-bom:2.0.0",
        "com.fasterxml.jackson:jackson-bom:2.22.0",
        "org.junit:junit-bom:6.1.1",
    ],
    generate_compat_repositories = True,
    known_contributing_modules = [
        "",
        "moon-base",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")
