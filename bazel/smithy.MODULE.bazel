bazel_dep(name = "smithy_cpp", version = "0.0.0")

# smithy_cpp is not published to the Bazel Central Registry yet, so the module
# version above is a placeholder and the source comes from the pinned archive
# below. The integrity hash pins the contents, so a re-pointed URL fails
# loudly rather than silently changing the build.
# Evaluation: https://github.com/muchq/MoonBase/issues/1168
#
# Carries muchq/smithy-cpp#192 (a01f0d2): the transport frames a HEAD with the
# GET's Content-Length and no octets, on both server transports and both
# clients. iili models HEAD /iili/v1/r/{slug} on it (#1433).
#
# Carries muchq/smithy-cpp#187: modeled 3xx redirects — a typed success
# carrying Location instead of a GenericError. iili's
# GET /iili/v1/r/{slug} needs it (#1359).
#
# Carries muchq/smithy-cpp#173 (4208f791): terminal transitions fire the
# parked send before the parked receive so End()/Close cannot deadlock when a
# harvested send waiter still holds the stream pin. Golf hub e2e Quiesce is
# defense-in-depth for unread wake frames; the End() hang that motivated it
# is fixed upstream here.
archive_override(
    module_name = "smithy_cpp",
    integrity = "sha256-jhhrKZMIWJk+50BPFQEgjhrvcIDIQvafLFyBih/C26k=",
    strip_prefix = "smithy-cpp-a01f0d2f570f3dafede5974570ed03a487b56eb2",
    urls = [
        "https://github.com/muchq/smithy-cpp/archive/a01f0d2f570f3dafede5974570ed03a487b56eb2.tar.gz",
    ],
)
