bazel_dep(name = "muchq_rules_gleam", version = "0.0.0", repo_name = "rules_gleam")
git_override(
    module_name = "muchq_rules_gleam",
    commit = "cd2680bc4bc02a625b3e0a5d7d4bc4bdab3416a2",
    remote = "https://github.com/muchq/rules_gleam.git",
)

gleam = use_extension("@rules_gleam//gleam:extensions.bzl", "gleam")
gleam.toolchain(version = "1.17.0")

# hpack_erl (mist's HTTP/2 header codec) is plain Erlang: no native code, no
# build hooks. scripts/diff-build-lib.sh names the manifest, which no target
# owns, so that a pin bump alone still builds everything.
gleam.hex_manifest(
    manifest = "//domains/games/apis/mithril_v2:manifest.toml",
    plain_erlang_packages = ["hpack_erl"],
)
use_repo(gleam, "gleam_host", "gleam_packages", "gleam_toolchains", "local_config_erlang")

register_toolchains("@gleam_toolchains//:all")

register_toolchains("@local_config_erlang//:erlang_toolchain_definition")
