load("@io_bazel_rules_go//go:def.bzl", "go_test")

# Named for the package directory so `bazel run //:gazelle` recognizes this
# rule and merges into it, rather than generating a second, data-less target
# beside it that could never find the configs.
go_test(
    name = "consolidated_test",
    size = "small",
    srcs = ["deploy_config_test.go"],
    data = [
        "Caddyfile",
        "Caddyfile.local",
        "compose.yaml",
        # Run, not read, by TestTheServicesListingMatchesWhatCanBeDeployed: the
        # --services listing is awk and sed, and asserting on their text is not
        # asserting on their output. The script self-locates and reads
        # compose.yaml from the repo root, which is why that path has to hold
        # in the runfiles tree too.
        "deploy.sh",
        "docker-compose.observability.yml",
        "initialize_host.sh",
        "local_deploy.sh",
        "o11y/otel-collector.yml",
        # Read by TestCIStillRunsTheCollectorDryRun, which checks that CI has not
        # quietly stopped invoking the collector dry-run.
        "//:.github/workflows/branch.yml",
        "//:scripts/validate-otel-config",
    ],
)
