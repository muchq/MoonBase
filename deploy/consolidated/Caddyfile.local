# Refusals every site imports above its own handles. Two guests, refused on
# every host by both User-Agent and address, the redundancy being the point: an
# agent may stop naming itself and a range may move.
#
# meta-externalagent (#1447) crawls from ~70 addresses across 57.141.0.0/16
# and starves Forgejo's git-backed pages; nothing it fetches here is welcome,
# and robots.txt is not the lever -- it requests what Forgejo's disallows.
# TLM-Audit-Scanner (#1458) walks each vhost for exposed credentials (.env,
# .aws, .git-credentials, cloud keys) from two Techoff SRV addresses and
# ignores robots.txt.
#
# One matcher per condition and one handle per matcher: a matcher block ANDs
# its conditions, and these must be an OR.
(refuse_bots) {
	@meta_agent header_regexp User-Agent (?i)meta-externalagent
	# The range is shared with Meta's link unfurler, which fetches a short link
	# once when someone pastes it into a Meta app; those two redirect paths stay
	# open to the range so previews keep working, and everything else is refused.
	@meta_subnet {
		remote_ip 57.141.0.0/16
		not path /r/* /iili/v1/r/*
	}
	@scanner_agent header_regexp User-Agent (?i)tlm-audit-scanner
	@scanner_address remote_ip 195.178.110.199 45.148.10.67

	handle @meta_agent {
		respond 403
	}

	handle @meta_subnet {
		respond 403
	}

	handle @scanner_agent {
		respond 403
	}

	handle @scanner_address {
		respond 403
	}
}

:2015 {
	import refuse_bots

	@post_portrait {
		method POST
		path /portrait/v1/trace
	}

	@post_mithril {
		method POST
		path /mithril/v1/wordchain
	}

	@post_posterize_blur {
		method POST
		path /imagine/v1/blur
	}

	@post_posterize_edges {
		method POST
		path /imagine/v1/edges
	}

	@get_metrics {
		method GET
		path /metrics/v1/*
	}

	@post_golf_v2_session {
		method POST
		path /games/v2/session
	}

	@ws_play_v2 {
		path /games/v2/play
	}

	@options {
		method OPTIONS
	}

	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization"
		Access-Control-Max-Age "86400"
	}

	handle @options {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	handle @post_golf_v2_session {
		reverse_proxy localhost:8089
	}
	handle @ws_play_v2 {
		reverse_proxy localhost:8089
	}
	handle @post_portrait {
		reverse_proxy localhost:8081
	}
	handle @get_metrics {
		reverse_proxy localhost:8082
	}
	handle @post_mithril {
		reverse_proxy localhost:8083
	}
	handle @post_posterize_blur {
		reverse_proxy localhost:8084
	}
	handle @post_posterize_edges {
		reverse_proxy localhost:8084
	}

	# Nothing else is routed: an unmatched path (or a HEAD on a GET-only
	# matcher) is a 404, not the empty 200 a fall-through answers with (#1468).
	# Two things still answer sub-400 on any path: the preflight handler
	# above, which matches OPTIONS regardless of path, and the websocket
	# matchers, which carry no method. Last on purpose — handle blocks run
	# in written order, and one placed earlier would shadow every route
	# below it; deploy_config_test.go pins the position.
	handle {
		respond 404
	}

	log {
		output stdout
	}
}
