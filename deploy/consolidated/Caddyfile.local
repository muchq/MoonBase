# Refusals every site imports first. Two guests, refused everywhere by both
# User-Agent and address, the redundancy being the point: an agent may stop
# naming itself and a range may move.
#
# meta-externalagent (#1447) walked git.muchq.com's git-backed pages from ~70
# addresses across 57.141.0.0/16 and starved Forgejo; the guard began there and
# now covers every host, since nothing it crawls here is welcome. robots.txt is
# not the lever -- it requests what Forgejo's disallows anyway. TLM-Audit-Scanner
# (#1458) walks each vhost for exposed credentials (.env, .aws, .git-credentials,
# cloud keys) from two Techoff SRV addresses and ignores robots.txt; the stats
# page counted nine thousand of its requests in a day, none refused.
#
# One matcher per condition and one handle per matcher: a matcher block ANDs
# its conditions, and these must be an OR.
(refuse_bots) {
	@meta_agent header_regexp User-Agent (?i)meta-externalagent
	@meta_subnet remote_ip 57.141.0.0/16
	@scanner_agent header_regexp User-Agent (?i)tlm-audit-scanner
	@scanner_address remote_ip 195.178.110.199 45.148.10.67

	handle @meta_agent {
		respond 403
	}

	handle @meta_subnet {
		respond 403
	}

	handle @scanner_agent {
		respond 403
	}

	handle @scanner_address {
		respond 403
	}
}

:2015 {
	import refuse_bots

	@post_portrait {
		method POST
		path /portrait/v1/trace
	}

	@post_mithril {
		method POST
		path /mithril/v1/wordchain
	}

	@post_posterize_blur {
		method POST
		path /imagine/v1/blur
	}

	@post_posterize_edges {
		method POST
		path /imagine/v1/edges
	}

	@get_metrics {
		method GET
		path /metrics/v1/*
	}

	@ws_thoughts {
		path /games/v1/thoughts-ws
	}

	@ws_golf {
		path /games/v1/golf-ws
	}

	@post_golf_v2_session {
		method POST
		path /games/v2/session
	}

	@ws_golf_v2 {
		path /games/v2/golf/play
	}

	@options {
		method OPTIONS
	}

	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization"
		Access-Control-Max-Age "86400"
	}

	handle @options {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	handle @ws_thoughts {
		reverse_proxy localhost:8080
	}
	handle @ws_golf {
		reverse_proxy localhost:8080
	}
	handle @post_golf_v2_session {
		reverse_proxy localhost:8089
	}
	handle @ws_golf_v2 {
		reverse_proxy localhost:8089
	}
	handle @post_portrait {
		reverse_proxy localhost:8081
	}
	handle @get_metrics {
		reverse_proxy localhost:8082
	}
	handle @post_mithril {
		reverse_proxy localhost:8083
	}
	handle @post_posterize_blur {
		reverse_proxy localhost:8084
	}
	handle @post_posterize_edges {
		reverse_proxy localhost:8084
	}

	# Nothing else is routed: an unmatched path (or a HEAD on a GET-only
	# matcher) is a 404, not the empty 200 a fall-through answers with (#1468).
	# Two things still answer sub-400 on any path: the preflight handler
	# above, which matches OPTIONS regardless of path, and the websocket
	# matchers, which carry no method. Last on purpose — handle blocks run
	# in written order, and one placed earlier would shadow every route
	# below it; deploy_config_test.go pins the position.
	handle {
		respond 404
	}

	log {
		output stdout
	}
}
