# Refusals every site imports above its own handles. Two guests, refused on
# every host by both User-Agent and address, the redundancy being the point: an
# agent may stop naming itself and a range may move.
#
# meta-externalagent (#1447) crawls from ~70 addresses across 57.141.0.0/16
# and starves Forgejo's git-backed pages; nothing it fetches here is welcome,
# and robots.txt is not the lever -- it requests what Forgejo's disallows.
# TLM-Audit-Scanner (#1458) walks each vhost for exposed credentials (.env,
# .aws, .git-credentials, cloud keys) from two Techoff SRV addresses and
# ignores robots.txt.
#
# One matcher per condition and one handle per matcher: a matcher block ANDs
# its conditions, and these must be an OR.
(refuse_bots) {
	@meta_agent header_regexp User-Agent (?i)meta-externalagent
	# The range is shared with Meta's link unfurler, which fetches a short link
	# once when someone pastes it into a Meta app; those two redirect paths stay
	# open to the range so previews keep working, and everything else is refused.
	@meta_subnet {
		remote_ip 57.141.0.0/16
		not path /r/* /iili/v1/r/*
	}
	@scanner_agent header_regexp User-Agent (?i)tlm-audit-scanner
	@scanner_address remote_ip 195.178.110.199 45.148.10.67

	handle @meta_agent {
		respond 403
	}

	handle @meta_subnet {
		respond 403
	}

	handle @scanner_agent {
		respond 403
	}

	handle @scanner_address {
		respond 403
	}
}

api.muchq.com {
	import refuse_bots

	@post_portrait {
		method POST
		path /portrait/v1/trace
	}

	@post_mithril {
		method POST
		path /mithril/v1/wordchain
	}

	@post_posterize_blur {
		method POST
		path /imagine/v1/blur
	}

	@post_posterize_edges {
		method POST
		path /imagine/v1/edges
	}

	@post_generate {
		method POST
		path /microgpt/v1/generate
	}

	@post_chat {
		method POST
		path /microgpt/v1/chat
	}

	@get_metrics {
		method GET
		path /metrics/v1/*
	}

	@get_1d4_health {
		method GET
		path /1d4/v1/health
	}

	@post_1d4_index {
		method POST
		path /1d4/v1/index
	}

	@get_1d4_index {
		method GET
		path /1d4/v1/index/*
	}

	@post_1d4_query {
		method POST
		path /1d4/v1/query
	}

	@post_v2_analyze {
		method POST
		path /v2/analyze
	}

	@get_stats {
		method GET
		path /stats/v1/*
	}

	@post_iili_shorten {
		method POST
		path /iili/v1/shorten
	}

	@get_iili_redirect {
		method GET
		path /iili/v1/r/*
	}

	@post_golf_v2_session {
		method POST
		path /games/v2/session
	}

	@ws_play_v2 {
		path /games/v2/play
	}

	@ws_golf_v2 {
		path /games/v2/golf/play
	}

	@ws_thoughts_v2 {
		path /games/v2/thoughts/play
	}

	@options {
		method OPTIONS
	}

	# Browser origins that call this API: muchq.com pages (incl. /iili)
	# and the iili.uk SPA (plus its vite dev — every API here is public
	# and credential-less, so a localhost origin grants nothing curl
	# doesn't have). ACAO takes one value, so it's echoed per origin;
	# Vary keeps shared caches from serving one origin's answer to the
	# other.
	@from_muchq header Origin https://muchq.com
	@from_iili header Origin https://iili.uk
	@from_dev header Origin http://localhost:5173

	header {
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization"
		Access-Control-Max-Age "86400"
		Vary Origin
	}
	header @from_muchq Access-Control-Allow-Origin "https://muchq.com"
	header @from_iili Access-Control-Allow-Origin "https://iili.uk"
	header @from_dev Access-Control-Allow-Origin "http://localhost:5173"

	handle @options {
		header {
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization"
			Access-Control-Max-Age "86400"
			Vary Origin
		}
		header @from_muchq Access-Control-Allow-Origin "https://muchq.com"
		header @from_iili Access-Control-Allow-Origin "https://iili.uk"
		header @from_dev Access-Control-Allow-Origin "http://localhost:5173"
		respond 204
	}

	handle @post_golf_v2_session {
		reverse_proxy games_hub:8089
	}
	handle @ws_play_v2 {
		reverse_proxy games_hub:8089
	}
	handle @ws_golf_v2 {
		reverse_proxy games_hub:8089
	}
	handle @ws_thoughts_v2 {
		reverse_proxy games_hub:8089
	}
	handle @post_portrait {
		reverse_proxy portrait:8081
	}
	handle @get_metrics {
		reverse_proxy prom_proxy:8082
	}
	handle @post_mithril {
		reverse_proxy mithril:8083
	}
	handle @post_posterize_blur {
		reverse_proxy posterize:8084
	}
	handle @post_posterize_edges {
		reverse_proxy posterize:8084
	}
	handle @post_generate {
		reverse_proxy microgpt-serve:8087
	}
	handle @post_chat {
		reverse_proxy microgpt-serve:8087
	}

	handle @get_1d4_health {
		rewrite * /health
		reverse_proxy one_d4:8080
	}
	handle @post_1d4_index {
		rewrite * /v1/index
		reverse_proxy one_d4:8080
	}
	handle @get_1d4_index {
		uri strip_prefix /1d4
		reverse_proxy one_d4:8080
	}
	handle @post_1d4_query {
		rewrite * /v1/query
		reverse_proxy one_d4:8080
	}
	# No rewrite: one_d4_v2 serves the gateway path itself, so the route a
	# client sees and the route the model declares are one string.
	handle @post_v2_analyze {
		reverse_proxy one_d4_v2:8090
	}

	# Same pattern (#1359): iili serves /iili/v1/* unrewritten.
	handle @post_iili_shorten {
		reverse_proxy iili:8091
	}
	# stats (#1460): read-only aggregates, unrewritten like the rest.
	handle @get_stats {
		reverse_proxy stats:8092
	}
	handle @get_iili_redirect {
		reverse_proxy iili:8091
	}

	# Nothing else is routed: an unmatched path (or a HEAD on a GET-only
	# matcher) is a 404, not the empty 200 a fall-through answers with (#1468).
	# Two things still answer sub-400 on any path: the preflight handler
	# above, which matches OPTIONS regardless of path, and the websocket
	# matchers, which carry no method. Last on purpose — handle blocks run
	# in written order, and one placed earlier would shadow every route
	# below it; deploy_config_test.go pins the position.
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 4mb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}

# Short-link redirects for iili.uk (#1359); the SPA is on Cloudflare at
# iili.uk. The public /r/{slug} is rewritten onto iili's modeled
# /iili/v1/r/{slug} — the deliberate exception to "gateway == model path".
i.iili.uk {
	import refuse_bots

	@getredir {
		method GET HEAD
		path /r/*
	}
	handle @getredir {
		rewrite * /iili/v1{path}
		reverse_proxy iili:8091
	}
	respond 404

	log {
		output file /var/log/caddy/access.log {
			roll_size 4mb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}

consolidated.cmptr.info {
	import refuse_bots

	respond "Consolidating..."
}

git.muchq.com {
	import refuse_bots

	# Forgejo runs under a 0.5-CPU cap and the git-backed pages fork real work
	# per request, so a crawler walking them starves the site (#1447). The
	# guests refuse_bots names are refused everywhere; this guard is for every
	# other self-identified crawler, on the routes that cost.
	#
	# Only HTTP. Git over SSH reaches forgejo on host port 222, not through Caddy.
	#
	# Both conditions live in one matcher block, where Caddy ANDs them. Split
	# into two matchers they become an OR, which is wrong in both directions at
	# once: crawlers lose the cheap pages they are welcome to, and humans lose
	# /commit/ and /blame/.
	#
	# The six routes are the ones that invoke git. /issues/ and /raw/ stay open
	# deliberately -- a database read and a file read, an order of magnitude
	# cheaper, and worth more as indexable pages than as saved CPU.
	@crawler_on_expensive_route {
		header_regexp User-Agent (?i)(bot|crawler|spider|scrap|slurp|archiver|externalagent|semrush|ahrefs|dataforseo)
		path_regexp ^/[^/]+/[^/]+/(commit|commits|compare|blame|src|archive)(/|$)
	}

	# handle blocks, not bare respond/reverse_proxy: these are mutually exclusive
	# and run in written order, so the guards' precedence is this file's order
	# rather than Caddy's directive order.
	handle @crawler_on_expensive_route {
		respond 403
	}

	handle {
		reverse_proxy forgejo:3000
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 4mb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}

