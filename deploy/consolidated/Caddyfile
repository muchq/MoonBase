	import refuse_bots

	@post_generate {
		method POST
		path /microgpt/v1/generate
	}

	@post_chat {
		method POST
		path /microgpt/v1/chat
	}

	@options {
		method OPTIONS
	}

	header {
		Access-Control-Allow-Origin "https://tty1.uk"
		Access-Control-Allow-Methods "POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "86400"
	}

	handle @options {
		header {
			Access-Control-Allow-Origin "https://tty1.uk"
			Access-Control-Allow-Methods "POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	handle @post_generate {
		reverse_proxy microgpt-serve:8087
	}
	handle @post_chat {
		reverse_proxy microgpt-serve:8087
	}

	# Nothing else is routed: an unmatched path (or a HEAD on a GET-only
	# matcher) is a 404, not the empty 200 a fall-through answers with (#1468).
	# Two things still answer sub-400 on any path: the preflight handler
	# above, which matches OPTIONS regardless of path, and the websocket
	# matchers, which carry no method. Last on purpose — handle blocks run
	# in written order, and one placed earlier would shadow every route
	# below it; deploy_config_test.go pins the position.
	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 4mb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}

