		}
	}
}

gpt.muchq.com {
	@post_generate {
		method POST
		path /microgpt/v1/generate
	}

	@post_chat {
		method POST
		path /microgpt/v1/chat
	}

	@options {
		method OPTIONS
	}

	header {
		Access-Control-Allow-Origin "https://tty1.uk"
		Access-Control-Allow-Methods "POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "86400"
	}

	handle @options {
		header {
			Access-Control-Allow-Origin "https://tty1.uk"
			Access-Control-Allow-Methods "POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	reverse_proxy @post_generate microgpt-serve:8087
	reverse_proxy @post_chat microgpt-serve:8087

	log {
		output file /var/log/caddy/access.log {
			roll_size 1gb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}

api.1d4.net {
	@post_index {
		method POST
		path /v1/index
	}

	@get_index {
		method GET
		path /v1/index /v1/index/*
	}

	@post_query {
		method POST
		path /v1/query
	}

	@get_health {
		method GET
		path /health
	}

	@options {
		method OPTIONS
	}

	header {
		Access-Control-Allow-Origin "https://1d4.net"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization"
		Access-Control-Max-Age "86400"
	}

	handle @options {
		header {
			Access-Control-Allow-Origin "https://1d4.net"
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	handle @post_index {
		reverse_proxy one_d4:8080
	}

	handle @get_index {
		reverse_proxy one_d4:8080
	}

	handle @post_query {
		reverse_proxy one_d4:8080
	}

	handle @get_health {
		reverse_proxy one_d4:8080
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 1gb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}

mcp.1d4.net {
	# Every method on /mcp reaches the server, not just POST. Streamable HTTP
	# clients probe GET for the optional server->client SSE stream and may send
	# DELETE to end a session; micronaut-mcp offers neither and answers 405,
	# which is what the transport spec says to do and what a client knows how to
	# read. Proxying POST alone left those falling through to Caddy's empty 200
	# — a body no client can parse, and the "GET /mcp returns 200 with an empty
	# body" probe in #1325.
	@mcp {
		path /mcp
	}

	@options {
		method OPTIONS
		path /mcp
	}

	# CORS, so 1d4.net's /mcp page can call tools/list from the browser. The
	# MCP-specific request headers are named because a Streamable HTTP client
	# sends them on every request after the handshake; without them in the
	# allow-list the preflight fails and the call never goes out.
	header {
		Access-Control-Allow-Origin "https://1d4.net"
		Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, MCP-Protocol-Version"
		Access-Control-Expose-Headers "Mcp-Session-Id"
		Access-Control-Max-Age "86400"
	}

	handle @options {
		header {
			Access-Control-Allow-Origin "https://1d4.net"
			Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, MCP-Protocol-Version"
			Access-Control-Expose-Headers "Mcp-Session-Id"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	handle @mcp {
		reverse_proxy mcpserver:8080
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 1gb
			roll_keep 5
			roll_keep_for 90d
		}
	}
}
